{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Replace every sample value in the ignored wrangler.self-host.jsonc copy.
  "name": "replace-with-your-worker-name",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "replace-with-your-d1-database-name",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "replace-with-your-r2-bucket-name",
    },
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "run_worker_first": true,
  },
  // When enabling Cron Triggers, keep the exact schedules here and add
  // matching non-secret INGEST_CRON and EDITION_CRON vars in this ignored copy.
}
