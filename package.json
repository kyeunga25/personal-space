{
  "name": "personal-space",
  "version": "0.8.0",
  "description": "A bilingual publishing application for Cloudflare Workers with a protected owner Studio.",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "homepage": "https://space.k-y.cc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyeunga25/personal-space.git"
  },
  "bugs": {
    "url": "https://github.com/kyeunga25/personal-space/issues"
  },
  "keywords": [
    "astro",
    "cloudflare-workers",
    "cloudflare-d1",
    "cloudflare-r2",
    "publishing",
    "typescript"
  ],
  "engines": {
    "node": ">=22.22.3",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/sanitize-build-paths.mjs",
    "preview": "npm run build && wrangler dev --local --host localhost --local-upstream localhost --env-file .dev.vars.example",
    "deploy": "node scripts/require-deploy-config.mjs && npm run build && wrangler deploy",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "worker:types": "wrangler types --env-file .dev.vars.example",
    "worker:types:check": "wrangler types --env-file .dev.vars.example --check",
    "worker:dry-run": "wrangler deploy --dry-run",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run worker:types:check && npm run worker:dry-run"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.2.0",
    "astro": "7.2.0",
    "fast-xml-parser": "^5.10.1",
    "jose": "6.2.8",
    "marked": "18.0.9",
    "sanitize-html": "2.17.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "@types/sanitize-html": "2.16.1",
    "eslint": "10.8.1",
    "eslint-plugin-astro": "3.1.0",
    "globals": "17.9.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10",
    "wrangler": "4.131.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260804.1": true,
    "fsevents@2.3.3": true
  }
}
