{
  "name": "personal-space",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.3",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/sanitize-build-paths.mjs",
    "preview": "npm run build && wrangler dev --local --host localhost --local-upstream localhost --env-file .dev.vars.example",
    "deploy": "npm run build && wrangler deploy",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "worker:types": "wrangler types --env-file .dev.vars.example",
    "worker:types:check": "wrangler types --env-file .dev.vars.example --check",
    "worker:dry-run": "wrangler deploy --dry-run",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run worker:types:check && npm run worker:dry-run"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.1.7",
    "astro": "7.1.6",
    "fast-xml-parser": "^5.10.1",
    "jose": "6.2.8",
    "marked": "18.0.9",
    "sanitize-html": "2.17.6"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.2",
    "@types/sanitize-html": "2.16.1",
    "eslint": "^10.8.0",
    "eslint-plugin-astro": "3.1.0",
    "globals": "17.9.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "7.0.2",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10",
    "wrangler": "4.118.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260722.1": true,
    "fsevents@2.3.3": true
  }
}
