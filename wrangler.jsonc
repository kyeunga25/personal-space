{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "personal-space",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-07-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },

  // Phase 1 adds D1 and R2 bindings after preview resources exist.
  // Later phases add Queues and Cron Triggers; no placeholder IDs or secrets
  // are committed here. Add the custom domain only after preview validation.
}
