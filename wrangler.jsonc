{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "personal-space",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-07-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "d1_databases": [
    {
      "binding": "DB",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
    },
  ],
  "workers_dev": false,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "space.k-y.cc",
      "custom_domain": true,
    },
  ],
  "triggers": {
    "crons": ["15 0,12 * * *", "0 14 * * *"],
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
