---
import BottomNav from "../components/BottomNav.astro";
import ContextRail from "../components/ContextRail.astro";
import MobileHeader from "../components/MobileHeader.astro";
import SiteRail from "../components/SiteRail.astro";
import { SITE } from "../config/site";
import "../styles/global.css";

interface Props {
  title?: string;
  titleEn?: string;
  description?: string;
  descriptionEn?: string;
  section?: string;
  sectionEn?: string;
  noIndex?: boolean;
}

const {
  title,
  titleEn,
  description = SITE.description,
  descriptionEn = SITE.descriptionEn,
  noIndex = false,
} = Astro.props;
const pageTitle = title
  ? `${title}${titleEn ? ` ${titleEn}` : ""} · ${SITE.name}`
  : SITE.name;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={`${description} ${descriptionEn}`} />
    <meta name="theme-color" content="#eef8ff" />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content"
      >跳至主要內容 <span lang="en">Skip to content</span></a
    >
    <MobileHeader />
    <div class="app-shell">
      <SiteRail pathname={Astro.url.pathname} />
      <main id="main-content" tabindex="-1">
        <slot />
      </main>
      <ContextRail />
    </div>
    <BottomNav pathname={Astro.url.pathname} />
  </body>
</html>
