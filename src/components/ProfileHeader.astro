---
import { profileNavigation } from "../config/navigation";
import { isActivePath } from "../lib/navigation";
import BrandMark from "./BrandMark.astro";

interface Props {
  pathname: string;
}

const { pathname } = Astro.props;
---

<section class="profile-header" aria-labelledby="profile-title">
  <div class="profile-header__cover" aria-hidden="true">
    <span class="profile-header__star profile-header__star--one"></span>
    <span class="profile-header__star profile-header__star--two"></span>
    <span class="profile-header__star profile-header__star--three"></span>
    <span class="profile-header__rhythm"></span>
  </div>

  <div class="profile-header__identity">
    <BrandMark avatar />
    <div class="profile-header__copy">
      <h1 id="profile-title">
        我的空間 <small lang="en">My Space</small>
      </h1>
      <p>這裡集中整理已公開的筆記、文章與選輯。</p>
      <p class="profile-header__english" lang="en">
        A clear place for public notes, articles, and reviewed editions.
      </p>
    </div>
  </div>

  <nav class="profile-tabs" aria-label="內容分類 Content categories">
    {
      profileNavigation.map((item) => {
        const active = isActivePath(pathname, item.href);
        return (
          <a
            class:list={{ "is-active": active }}
            href={item.href}
            aria-current={active ? "page" : undefined}
          >
            <span>{item.label}</span>
            <small lang="en">{item.labelEn}</small>
          </a>
        );
      })
    }
  </nav>
</section>

<style>
  .profile-header {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--space-border-strong);
    background:
      radial-gradient(
        circle at 76% 30%,
        rgba(250, 224, 154, 0.38),
        transparent 17rem
      ),
      linear-gradient(
        135deg,
        rgba(233, 243, 255, 0.9),
        rgba(240, 239, 252, 0.82) 54%,
        rgba(255, 248, 225, 0.78)
      );
  }

  .profile-header__cover {
    position: absolute;
    z-index: 0;
    inset: 0 0 auto;
    height: 20rem;
    overflow: hidden;
    background:
      linear-gradient(
        151deg,
        transparent 0 37%,
        rgba(255, 255, 255, 0.66) 37.2% 43%,
        transparent 43.2% 49%,
        rgba(127, 139, 212, 0.18) 49.2% 49.5%,
        transparent 49.8%
      ),
      linear-gradient(
        145deg,
        transparent 0 61%,
        rgba(232, 186, 77, 0.34) 61.2% 61.48%,
        transparent 61.7%
      );
  }

  .profile-header__cover::before {
    position: absolute;
    top: 0;
    right: 0;
    width: 12rem;
    height: 11rem;
    background-image: radial-gradient(
      circle,
      rgba(132, 145, 216, 0.2) 0 1.05px,
      transparent 1.45px
    );
    background-size: 0.62rem 0.62rem;
    content: "";
    mask-image: linear-gradient(225deg, black, transparent 76%);
    opacity: 0.5;
  }

  .profile-header__star {
    position: absolute;
    width: 1.75rem;
    height: 1.75rem;
    background: var(--space-primary-soft);
    clip-path: polygon(
      50% 0,
      61% 39%,
      100% 50%,
      61% 61%,
      50% 100%,
      39% 61%,
      0 50%,
      39% 39%
    );
  }

  .profile-header__star--one {
    top: 2.75rem;
    left: 36%;
  }

  .profile-header__star--two {
    top: 1rem;
    right: 5%;
    width: 4rem;
    height: 4rem;
    background: rgba(255, 255, 255, 0.74);
  }

  .profile-header__star--three {
    right: 43%;
    bottom: 2.2rem;
    width: 1.15rem;
    height: 1.15rem;
    background: var(--space-yellow);
  }

  .profile-header__rhythm {
    position: absolute;
    top: 2rem;
    left: 1.5rem;
    width: 6.5rem;
    height: 3.5rem;
    background: repeating-linear-gradient(
      to right,
      rgba(127, 139, 212, 0.24) 0 0.28rem,
      transparent 0.28rem 0.56rem
    );
    clip-path: polygon(
      0 80%,
      10% 42%,
      20% 64%,
      30% 22%,
      40% 48%,
      50% 0,
      60% 34%,
      70% 56%,
      80% 25%,
      90% 66%,
      100% 44%,
      100% 100%,
      0 100%
    );
  }

  .profile-header__identity {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
    padding: 4.75rem clamp(1.75rem, 5vw, 3.5rem) 3.5rem;
  }

  .profile-header__copy {
    min-width: 0;
  }

  h1 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3);
    margin: 0;
    color: var(--space-ink);
    font-size: var(--font-size-3);
    letter-spacing: -0.045em;
    line-height: 1.08;
  }

  h1 small {
    color: var(--space-primary-strong);
    font-size: 0.62em;
    font-weight: 720;
    letter-spacing: -0.02em;
  }

  .profile-header__copy > p {
    max-width: 35rem;
    margin: var(--space-3) 0 0;
    color: var(--space-ink);
    font-size: var(--font-size-1);
    font-weight: 690;
    line-height: 1.55;
  }

  .profile-header__copy .profile-header__english {
    color: var(--space-ink-muted);
    font-size: var(--font-size--1);
    font-weight: 490;
    line-height: 1.5;
  }

  .profile-tabs {
    position: relative;
    z-index: 1;
    display: grid;
    min-height: 4.6rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--space-border);
    background: rgba(255, 255, 255, 0.5);
    backdrop-filter: blur(16px);
  }

  .profile-tabs a {
    position: relative;
    display: flex;
    min-width: 0;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-3);
    color: var(--space-ink-muted);
    font-weight: 700;
    text-decoration: none;
    transition:
      background-color var(--motion-fast) ease,
      color var(--motion-fast) ease;
  }

  .profile-tabs a::after {
    position: absolute;
    right: 10%;
    bottom: -1px;
    left: 10%;
    height: 3px;
    border-radius: var(--radius-pill);
    background: transparent;
    content: "";
  }

  .profile-tabs a:hover {
    background: var(--space-surface-hover);
    color: var(--space-primary-strong);
  }

  .profile-tabs a.is-active {
    color: var(--space-primary-strong);
    background: linear-gradient(
      135deg,
      rgba(255, 245, 210, 0.72),
      rgba(231, 229, 250, 0.66)
    );
  }

  .profile-tabs a.is-active::after {
    background: linear-gradient(
      90deg,
      var(--space-yellow-vivid),
      var(--space-primary)
    );
  }

  .profile-tabs small {
    font-size: 0.78em;
    font-weight: 560;
  }

  @media (max-width: 47.99rem) {
    .profile-header__cover {
      height: 19rem;
    }

    .profile-header__cover::before {
      right: -1rem;
      width: 10rem;
      height: 9rem;
    }

    .profile-header__rhythm {
      top: 3.5rem;
      left: 0.75rem;
      width: 5rem;
      height: 4rem;
    }

    .profile-header__identity {
      display: grid;
      grid-template-columns: minmax(6.5rem, 7.5rem) minmax(0, 1fr);
      gap: var(--space-5);
      align-items: center;
      padding: 4.5rem var(--page-gutter) var(--space-6);
    }

    .profile-header__identity :global(.brand-mark--avatar) {
      display: grid;
      width: clamp(6.5rem, 29vw, 7.5rem);
      height: clamp(6.5rem, 29vw, 7.5rem);
      margin: 0;
    }

    .profile-header__copy {
      padding-top: 0;
    }

    h1 {
      display: block;
      font-size: var(--font-size-3);
      line-height: 1.12;
    }

    h1 small {
      display: block;
      margin-top: var(--space-2);
      font-size: 0.58em;
    }

    .profile-header__copy > p {
      max-width: 26ch;
      font-size: var(--font-size-0);
      font-weight: 680;
      line-height: 1.55;
    }

    .profile-header__copy .profile-header__english {
      max-width: 30ch;
      font-size: var(--font-size--1);
      font-weight: 470;
      line-height: 1.55;
    }

    .profile-tabs {
      min-height: 4.75rem;
      margin-inline: var(--space-3);
      overflow: hidden;
      border: 1px solid var(--space-border-strong);
      border-radius: var(--radius-lg) var(--radius-lg) 0 0;
      box-shadow: 0 -10px 34px rgba(81, 94, 152, 0.06);
    }

    .profile-tabs a {
      flex-direction: column;
      gap: 0;
      padding-inline: var(--space-2);
      font-size: var(--font-size-0);
    }
  }
</style>
