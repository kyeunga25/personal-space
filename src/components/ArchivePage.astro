---
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatHongKongMonth } from "../lib/dates";
import { archivePeriod } from "../lib/navigation";
import type { ArchiveMonth } from "../server/discovery/types";
import type { PostRecord } from "../server/publishing/domain";
import DiscoveryPostList from "./DiscoveryPostList.astro";

interface Props {
  currentMonth?: string | null;
  currentYear?: string | null;
  months: ArchiveMonth[];
  nextHref?: string | null;
  posts: PostRecord[];
  title?: string;
}

const {
  currentMonth = null,
  currentYear = null,
  months,
  nextHref = null,
  posts,
  title = currentMonth
    ? formatHongKongMonth(currentMonth)
    : currentYear
      ? `${currentYear} 年`
      : "全部封存",
} = Astro.props;
const activePeriod = archivePeriod(currentYear, currentMonth);
const emptyDescription =
  activePeriod === "month"
    ? "這個月份暫未有公開內容。"
    : activePeriod === "year"
      ? "這個年份暫未有公開內容。"
      : "目前沒有公開封存內容。";
const emptyDescriptionEn =
  activePeriod === "month"
    ? "No public entries in this month."
    : activePeriod === "year"
      ? "No public entries in this year."
      : "No public archive entries yet.";
---

<BaseLayout
  title="封存"
  titleEn="Archive"
  description="依照香港時間與發布日期尋回公開內容。"
  descriptionEn="Browse public writing by publication month in Hong Kong time."
>
  <div class="page-stack">
    <header class="route-header">
      <h1>封存 <small lang="en">Archive</small></h1>
      <p>依照香港時間與發布日期尋回公開內容。</p>
      <p class="en-subline" lang="en">
        Browse public writing by publication month in Hong Kong time.
      </p>
    </header>

    <nav class="archive-months" aria-label="月份封存 Monthly archive">
      <a
        class:list={{ active: activePeriod === "all" }}
        href="/archive"
        aria-current={activePeriod === "all" ? "page" : undefined}
      >
        全部 <small lang="en">All</small>
      </a>
      {
        months.map((month) => {
          const [year, monthNumber] = month.month.split("-");
          const isCurrentMonth =
            activePeriod === "month" && currentMonth === month.month;
          return (
            <a
              class:list={{ active: isCurrentMonth }}
              href={`/archive/${year}/${monthNumber}`}
              aria-current={isCurrentMonth ? "page" : undefined}
            >
              <span>{formatHongKongMonth(month.month)}</span>
              <small>
                {month.total} · 筆記 {month.noteCount} · 文章{" "}
                {month.articleCount}
              </small>
            </a>
          );
        })
      }
    </nav>

    <header class="archive-heading">
      <h2>{title}</h2>
      <p>
        本頁 {posts.length} 項公開內容 · {posts.length} public entries on this page
      </p>
    </header>
    <DiscoveryPostList
      posts={posts}
      {nextHref}
      {emptyDescription}
      {emptyDescriptionEn}
    />
  </div>
</BaseLayout>

<style>
  .archive-months {
    display: flex;
    gap: var(--space-3);
    padding: var(--space-5) var(--page-gutter);
    overflow-x: auto;
    border-bottom: 1px solid var(--space-border-strong);
    background: linear-gradient(
      145deg,
      rgba(250, 252, 255, 0.72),
      rgba(241, 240, 252, 0.6)
    );
    scrollbar-width: thin;
  }

  .archive-months a {
    flex: 0 0 auto;
    min-width: 9rem;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--space-border);
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.72);
    color: var(--space-ink-muted);
    text-decoration: none;
  }

  .archive-months a.active {
    border-color: rgba(142, 128, 191, 0.28);
    background: linear-gradient(
      135deg,
      var(--space-surface-yellow),
      var(--space-surface-primary)
    );
    color: var(--space-ink);
    box-shadow: var(--space-shadow-glow);
  }

  .archive-months span,
  .archive-months small {
    display: block;
  }

  .archive-months small {
    margin-top: var(--space-1);
    color: var(--space-ink-faint);
    font-size: 0.72rem;
  }

  .archive-heading {
    padding: var(--space-5) var(--page-gutter);
    border-bottom: 1px solid var(--space-border);
  }

  .archive-heading h2,
  .archive-heading p {
    margin: 0;
  }

  .archive-heading h2 {
    font-size: var(--font-size-2);
  }

  .archive-heading p {
    margin-top: var(--space-2);
    color: var(--space-ink-faint);
    font-size: var(--font-size--1);
  }
</style>
