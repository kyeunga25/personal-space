---
import { POST_INPUT_LIMITS } from "../../config/publishing";
import {
  MEDIA_UPLOAD_LIMITS,
  MEDIA_UPLOAD_MIME_TYPES,
} from "../../config/media";
import {
  EDITOR_TAGS_INPUT_MAX_LENGTH,
  getEditorAutofocusTarget,
  getEditorBodyFeedback,
  getEditorCategoryFeedback,
  getEditorCharacterCount,
  getEditorExcerptFeedback,
  getEditorHeading,
  getEditorSlugFeedback,
  getEditorTagsFeedback,
  getEditorTitleFeedback,
} from "../../scripts/editor-input";
import {
  getPreviewHeaderContent,
  getPreviewReadingTimeContent,
  getPreviewTaxonomyContent,
} from "../../scripts/preview-header";
import { getPostVisibilitySummary } from "../../scripts/publish-confirmation";
import { resolveInitialPostSaveState } from "../../scripts/post-save-state";
import {
  formatHongKongScheduleInput,
  getScheduleActionState,
  getScheduleInputFeedback,
} from "../../scripts/schedule-confirmation";
import { renderMarkdown } from "../../server/content/markdown";
import type {
  MediaRecord,
  PostKind,
  PostRecord,
  PostRevision,
} from "../../server/publishing/domain";
import StudioIcon from "./StudioIcon.astro";

interface Props {
  hasRevisionCursor?: boolean;
  kind: PostKind;
  latestRevisionHref?: string | null;
  media?: MediaRecord | null;
  nextRevisionHref?: string | null;
  post?: PostRecord | null;
  revisions?: PostRevision[];
}

const {
  hasRevisionCursor = false,
  kind,
  latestRevisionHref = null,
  media = null,
  nextRevisionHref = null,
  post = null,
  revisions = [],
} = Astro.props;
const isArticle = kind === "article";
const autofocusTarget = getEditorAutofocusTarget(kind, !post);
const previewMedia = media && post?.heroMediaId === media.id ? media : null;
const title = post?.title ?? "";
const editorHeading = getEditorHeading({ kind, title });
if (!editorHeading) throw new Error("Invalid editor heading kind");
const titleFeedback = getEditorTitleFeedback({ kind, title });
if (!titleFeedback) throw new Error("Invalid editor title feedback kind");
const excerpt = post?.excerpt ?? "";
const bodyMd = post?.bodyMd ?? "";
const bodyFeedback = getEditorBodyFeedback({ bodyMd, kind });
if (!bodyFeedback) throw new Error("Invalid editor body feedback kind");
const category = post?.category?.name ?? "";
const previewHtml = bodyMd
  ? renderMarkdown(bodyMd)
  : "<p>預覽會在這裡出現。</p>";
const tags = post?.tags.map((tag) => tag.name).join(", ") ?? "";
const categoryFeedback = getEditorCategoryFeedback(category);
const excerptFeedback = getEditorExcerptFeedback(excerpt);
const tagsFeedback = getEditorTagsFeedback(tags);
const slugFeedback = getEditorSlugFeedback({
  originalSlug: post?.slug ?? "",
  slug: post?.slug ?? "",
  title,
});
const endpoint = post ? `/api/studio/posts/${post.id}` : "/api/studio/posts";
const method = post ? "PUT" : "POST";
const scheduledValue = formatHongKongScheduleInput(post?.scheduledAt);
const scheduleAction = getScheduleActionState(post?.status ?? null);
const scheduleFeedback = getScheduleInputFeedback(scheduledValue);
const usesWorkingCopy =
  post?.status === "published" || post?.status === "scheduled";
const initialSaveState = resolveInitialPostSaveState(
  !post ? "new" : post.hasWorkingCopy ? "working-copy" : "saved",
);
if (!initialSaveState) throw new Error("Invalid initial editor save state");
const titleCount = getEditorCharacterCount(title, POST_INPUT_LIMITS.title);
const excerptCount = getEditorCharacterCount(
  excerpt,
  POST_INPUT_LIMITS.excerpt,
);
const bodyCount = getEditorCharacterCount(bodyMd, POST_INPUT_LIMITS.bodyMd);
const previewHeader = getPreviewHeaderContent({ excerpt, kind, title });
const previewReadingTime = getPreviewReadingTimeContent(kind, bodyMd);
const previewTaxonomy = getPreviewTaxonomyContent(
  post?.category?.name ?? "",
  tags,
);
const previewVisibility = getPostVisibilitySummary(
  post?.visibility ?? "private",
);
if (!previewVisibility) throw new Error("Invalid editor preview visibility");
const mediaLimitMebibytes = MEDIA_UPLOAD_LIMITS.fileBytes / 1024 / 1024;
---

<form
  class="editor"
  data-editor-form
  data-endpoint={endpoint}
  data-method={method}
  data-kind={kind}
  data-post-id={post?.id ?? ""}
  data-restore-target={usesWorkingCopy ? "working-copy" : "draft"}
  novalidate
>
  <header class="editor-header">
    <a href="/studio" class="editor-header__back" aria-label="返回 Studio">←</a>
    <div class="editor-header__title">
      <h1 data-editor-heading>{editorHeading}</h1>
      <span
        >{
          post?.hasWorkingCopy
            ? "未發佈修改 Working copy"
            : post?.status === "published"
              ? "已發佈 Published"
              : post?.status === "scheduled"
                ? "已排程 Scheduled"
                : "草稿 Draft"
        }</span
      >
    </div>
    <p class="save-state" data-save-state aria-live="polite">
      {initialSaveState.label}
      <span lang="en">{initialSaveState.labelEn}</span>
    </p>
    <div class="editor-header__actions">
      <button
        class="studio-button studio-button--quiet"
        type="button"
        data-preview-button
      >
        <StudioIcon name="preview" />預覽 <span lang="en">Preview</span>
      </button>
      <button
        class="studio-button studio-button--primary"
        type="button"
        data-open-publish
        aria-keyshortcuts="Meta+Enter Control+Enter"
      >
        <StudioIcon name="send" />發佈 <span lang="en">Publish</span>
        <kbd class="editor-shortcut-hint" aria-hidden="true"
          >⌘ / Ctrl + Enter</kbd
        >
      </button>
    </div>
  </header>

  {
    post?.hasWorkingCopy && (
      <p class="working-copy-notice">
        目前顯示的是只限 Studio
        的工作副本；公開頁面仍使用上一個已發佈版本。按下「發佈」才會更新公開內容。
      </p>
    )
  }

  <div
    class="mobile-editor-tabs"
    role="tablist"
    aria-label="編輯模式 Editor mode"
    aria-orientation="horizontal"
  >
    <button
      id="editor-tab-write"
      class="is-active"
      type="button"
      role="tab"
      aria-controls="editor-panel-write"
      aria-selected="true"
      tabindex="0"
      data-editor-tab="write">撰寫 <span lang="en">Write</span></button
    >
    <button
      id="editor-tab-preview"
      type="button"
      role="tab"
      aria-controls="editor-panel-preview"
      aria-selected="false"
      tabindex="-1"
      data-editor-tab="preview">預覽 <span lang="en">Preview</span></button
    >
  </div>

  <div class="editor-grid">
    <section
      id="editor-panel-write"
      class="write-pane"
      role="tabpanel"
      aria-labelledby="editor-tab-write"
      data-write-pane
    >
      <div
        class="markdown-toolbar"
        role="toolbar"
        aria-label="Markdown 工具列 Markdown toolbar"
        aria-describedby="markdown-format-help"
      >
        <button
          type="button"
          data-md-prefix="# "
          data-md-mode="line"
          data-md-placeholder="章節標題 Section heading"
          data-md-line-format="heading"
          aria-label="切換章節標題 Toggle section heading"
          title="切換章節標題 Toggle section heading">H</button
        >
        <button
          type="button"
          data-md-prefix="**"
          data-md-suffix="**"
          data-md-placeholder="粗體文字 Bold text"
          data-md-inline-format="bold"
          data-md-shortcut="bold"
          aria-label="切換粗體 Toggle bold"
          aria-keyshortcuts="Meta+B Control+B"
          title="切換粗體 Toggle bold（⌘ / Ctrl + B）"
          ><strong>B</strong></button
        >
        <button
          type="button"
          data-md-prefix="*"
          data-md-suffix="*"
          data-md-placeholder="斜體文字 Italic text"
          data-md-inline-format="italic"
          data-md-shortcut="italic"
          aria-label="切換斜體 Toggle italic"
          aria-keyshortcuts="Meta+I Control+I"
          title="切換斜體 Toggle italic（⌘ / Ctrl + I）"><em>I</em></button
        >
        <button
          type="button"
          data-md-link
          data-md-shortcut="link"
          aria-label="加入、修改或移除連結 Add, edit, or remove link"
          aria-keyshortcuts="Meta+K Control+K"
          title="加入、修改或移除連結 Add, edit, or remove link（⌘ / Ctrl + K）"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true"
            ><path
              d="M10 13a5 5 0 0 0 7.5.5l2-2a5 5 0 0 0-7-7l-1 1M14 11a5 5 0 0 0-7.5-.5l-2 2a5 5 0 0 0 7 7l1-1"
            ></path></svg
          >
        </button>
        <button
          type="button"
          data-md-prefix="> "
          data-md-mode="line"
          data-md-placeholder="引用內容 Quote"
          data-md-line-format="quote"
          aria-label="切換引用 Toggle quote"
          title="切換引用 Toggle quote"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true"
            ><path d="M7 17h4V9H5v5h2v3ZM16 17h4V9h-6v5h2v3Z"></path></svg
          >
        </button>
        <button
          type="button"
          data-md-prefix="- "
          data-md-mode="line"
          data-md-placeholder="清單項目 List item"
          data-md-list-format="bullet"
          aria-label="切換項目清單 Toggle bulleted list"
          title="切換項目清單 Toggle bulleted list"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true"
            ><path d="M9 6h11M9 12h11M9 18h11M4 6h.01M4 12h.01M4 18h.01"
            ></path></svg
          >
        </button>
        <button
          type="button"
          data-md-prefix="1. "
          data-md-mode="line"
          data-md-placeholder="清單項目 List item"
          data-md-list-format="numbered"
          aria-label="切換編號清單 Toggle numbered list"
          title="切換編號清單 Toggle numbered list"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true"
            ><path d="M10 6h10M10 12h10M10 18h10M4 4v4M3 4h2M3 13h3l-3 4h3"
            ></path></svg
          >
        </button>
        <button
          type="button"
          data-md-code-block
          data-md-placeholder="在此貼上程式碼 Paste code here"
          aria-label="切換程式碼區塊 Toggle code block"
          title="切換程式碼區塊 Toggle code block">&lt;/&gt;</button
        >
        <button
          type="button"
          data-md-prefix="\n---\n"
          data-md-mode="insert"
          aria-label="插入分隔線 Insert separator"
          title="插入分隔線 Insert separator">—</button
        >
      </div>

      <div class="write-fields">
        <p class="markdown-format-help" id="markdown-format-help">
          選取普通文字後操作可加入連結；把游標放在現有連結內，可直接選取網址以便貼上替換。其他格式沒有選取時，會加入可直接取代的提示文字。
          <span lang="en">
            Select plain text to add a link. Place the cursor inside an existing
            link to select its URL for replacement. Other formats insert a
            replaceable prompt when nothing is selected.
          </span>
          <span>常用快捷鍵：⌘ / Ctrl + B 粗體、I 斜體、K 連結。</span>
          <span lang="en">
            Shortcuts: ⌘ / Ctrl + B bold, I italic, K link.
          </span>
          <span>
            選取已連結文字或整段連結後再次操作，可移除連結並保留文字。
          </span>
          <span lang="en">
            Place the cursor inside an existing link to edit its URL. Select
            linked text or the whole link, then repeat the action to remove the
            link and keep its text.
          </span>
          <span>
            再次操作粗體、斜體、章節標題、引用、程式碼區塊或目前的清單可移除格式；選擇另一種行格式或清單可直接轉換。
          </span>
          <span lang="en">
            Repeat bold, italic, a section heading, a quote, a code block, or
            the current list to remove that format. Choose another line or list
            format to convert it directly.
          </span>
          <span>
            正文不會載入外部圖片連結；需要圖片時，請使用<a href="#media"
              >封面媒體</a
            >。
          </span>
          <span lang="en">
            External image links are not loaded in the body. Use the
            <a href="#media">Cover upload</a>.
          </span>
        </p>
        <label>
          <span>標題 {isArticle ? "Title" : "（選填） Optional title"}</span>
          <input
            name="title"
            value={title}
            maxlength={POST_INPUT_LIMITS.title}
            aria-describedby="editor-title-feedback editor-title-count"
            autofocus={autofocusTarget === "title"}
            placeholder={isArticle
              ? "為文章寫一個清晰標題…"
              : "為筆記加上標題…"}
          />
          <small
            id="editor-title-feedback"
            class="editor-title-feedback"
            data-editor-title-feedback
            data-state={titleFeedback.state}
            aria-live="polite"
            aria-atomic="true"
          >
            {titleFeedback.label}
          </small>
          <small
            id="editor-title-count"
            class="editor-character-count"
            data-editor-character-count
            data-field-name="title"
            data-limit={POST_INPUT_LIMITS.title}
            data-state={titleCount.state}>{titleCount.label}</small
          >
        </label>
        {
          isArticle && (
            <label>
              <span>
                摘要 <small lang="en">Excerpt</small>
              </span>
              <textarea
                name="excerpt"
                rows="2"
                maxlength={POST_INPUT_LIMITS.excerpt}
                aria-describedby="editor-excerpt-feedback editor-excerpt-count"
                placeholder="給一般讀者的簡短摘要"
              >
                {excerpt}
              </textarea>
              <small
                id="editor-excerpt-feedback"
                class="editor-excerpt-feedback"
                data-editor-excerpt-feedback
                data-state={excerptFeedback.state}
                aria-live="polite"
                aria-atomic="true"
              >
                {excerptFeedback.label}
              </small>
              <small
                id="editor-excerpt-count"
                class="editor-character-count"
                data-editor-character-count
                data-field-name="excerpt"
                data-limit={POST_INPUT_LIMITS.excerpt}
                data-state={excerptCount.state}
              >
                {excerptCount.label}
              </small>
            </label>
          )
        }
        <label class="body-field">
          <span>內容 <small lang="en">Content (Markdown)</small></span>
          <textarea
            name="bodyMd"
            rows="24"
            maxlength={POST_INPUT_LIMITS.bodyMd}
            aria-describedby="editor-body-feedback editor-body-count"
            placeholder="記下一個值得保留的片刻。"
            autofocus={autofocusTarget === "bodyMd"}>{bodyMd}</textarea
          >
          <small
            id="editor-body-feedback"
            class="editor-body-feedback"
            data-editor-body-feedback
            data-state={bodyFeedback.state}
            aria-live="polite"
            aria-atomic="true"
          >
            {bodyFeedback.label}
          </small>
        </label>
        <div class="write-footer">
          <a
            href="https://www.markdownguide.org/basic-syntax/"
            rel="noopener noreferrer"
            target="_blank">Markdown 語法</a
          ><span
            id="editor-body-count"
            class="editor-character-count"
            data-editor-character-count
            data-field-name="bodyMd"
            data-limit={POST_INPUT_LIMITS.bodyMd}
            data-state={bodyCount.state}>{bodyCount.label}</span
          >
        </div>
      </div>
    </section>

    <section
      id="editor-panel-preview"
      class="preview-pane"
      role="tabpanel"
      aria-labelledby="editor-tab-preview"
      data-preview-pane
    >
      <p class="pane-label">
        閱讀頁面預覽 <span lang="en">Reading page preview</span>
      </p>
      <aside
        class="preview-visibility"
        data-preview-visibility
        data-visibility={previewVisibility.visibility}
        aria-live="polite"
        aria-atomic="true"
      >
        <strong data-preview-visibility-label>{previewVisibility.label}</strong>
        <span data-preview-visibility-effect>{previewVisibility.effect}</span>
      </aside>
      <article class="content-preview">
        <header class="content-preview__header" aria-live="polite">
          <p class="content-preview__kind">
            {isArticle ? "文章" : "筆記"}
            <span lang="en">{isArticle ? "Article" : "Note"}</span>
          </p>
          <h2 data-preview-title>{previewHeader.title}</h2>
          <p
            class="content-preview__excerpt"
            data-preview-excerpt
            hidden={!previewHeader.showExcerpt}
          >
            {previewHeader.excerpt}
          </p>
          <p
            class="content-preview__reading-time"
            data-preview-reading-time
            hidden={!previewReadingTime.show}
          >
            <span data-preview-reading-time-label>
              {previewReadingTime.label}
            </span>
            <span aria-hidden="true"> · </span>
            <span lang="en" data-preview-reading-time-label-en>
              {previewReadingTime.labelEn}
            </span>
          </p>
        </header>
        <figure
          class="content-preview__cover"
          data-preview-cover
          hidden={!previewMedia}
        >
          <img
            data-preview-cover-image
            src={previewMedia
              ? `/api/studio/media/${encodeURIComponent(previewMedia.id)}`
              : undefined}
            alt={previewMedia?.altText ?? ""}
            width={previewMedia?.width}
            height={previewMedia?.height}
          />
        </figure>
        <div
          class="markdown-preview"
          data-preview-output
          aria-live="polite"
          set:html={previewHtml}
        />
        <footer
          class="content-preview__taxonomy"
          data-preview-taxonomy
          hidden={!previewTaxonomy.show}
          aria-live="polite"
        >
          <h3>整理 <small lang="en">Filed under</small></h3>
          <p data-preview-taxonomy-items>
            {previewTaxonomy.items.join(" · ")}
          </p>
        </footer>
      </article>
    </section>

    <aside class="settings-pane" aria-label="發佈設定 Publish settings">
      <header>
        <h2>發佈設定 <small lang="en">Publish settings</small></h2><span
          aria-hidden="true">✦</span
        >
      </header>
      <div class="settings-fields">
        <label
          ><span>可見性 <small>Visibility</small></span>
          <select
            name="visibility"
            aria-describedby="editor-visibility-feedback"
          >
            <option
              value="private"
              selected={previewVisibility.visibility === "private"}
              >私人 Private</option
            >
            <option
              value="unlisted"
              selected={previewVisibility.visibility === "unlisted"}
              >不公開列出 Unlisted</option
            >
            <option
              value="public"
              selected={previewVisibility.visibility === "public"}
              >公開 Public</option
            >
          </select>
          <small
            id="editor-visibility-feedback"
            aria-live="polite"
            aria-atomic="true"
          >
            發佈後 <span lang="en">After publishing</span>：<span
              data-editor-visibility-effect>{previewVisibility.effect}</span
            >
          </small>
        </label>
        <label
          ><span>分類 <small>Category</small></span><input
            name="category"
            value={category}
            maxlength={POST_INPUT_LIMITS.category}
            aria-describedby="editor-category-feedback"
            placeholder="未分類"
          /><small
            id="editor-category-feedback"
            class="editor-category-feedback"
            data-editor-category-feedback
            data-state={categoryFeedback.state}
            aria-live="polite"
            aria-atomic="true">{categoryFeedback.label}</small
          ></label
        >
        <label
          ><span>標籤 <small>Tags</small></span><input
            name="tags"
            value={tags}
            maxlength={EDITOR_TAGS_INPUT_MAX_LENGTH}
            aria-describedby="editor-tags-hint editor-tags-feedback"
            placeholder="以逗號分隔，包括 , 或 ，"
          /><small id="editor-tags-hint"
            >最多 {POST_INPUT_LIMITS.tags} 個，每個 {POST_INPUT_LIMITS.tag} 字元 ·
            Up to {POST_INPUT_LIMITS.tags} tags, {POST_INPUT_LIMITS.tag} characters
            each</small
          ><small
            id="editor-tags-feedback"
            class="editor-tags-feedback"
            data-editor-tags-feedback
            data-state={tagsFeedback.state}
            aria-live="polite"
            aria-atomic="true">{tagsFeedback.label}</small
          ></label
        >
        {
          isArticle && (
            <label>
              <>
                <span>
                  網址代稱 <small>Slug</small>
                </span>
                <input
                  name="slug"
                  value={post?.slug ?? ""}
                  data-original-slug={post?.slug ?? ""}
                  maxlength={POST_INPUT_LIMITS.slug}
                  aria-describedby="editor-slug-feedback"
                  placeholder="由標題自動產生"
                />
                <small
                  id="editor-slug-feedback"
                  class="editor-slug-feedback"
                  data-editor-slug-feedback
                  data-state={slugFeedback.state}
                  aria-live="polite"
                  aria-atomic="true"
                >
                  {slugFeedback.label}
                </small>
              </>
            </label>
          )
        }
        <label
          ><span>排程 <small>香港時間 · Hong Kong time</small></span><input
            name="scheduledAt"
            type="datetime-local"
            value={scheduledValue}
            disabled={!scheduleAction.allowed}
            aria-describedby={scheduleAction.allowed
              ? "editor-schedule-help editor-schedule-feedback"
              : "editor-schedule-help"}
          /><small id="editor-schedule-help">
            {
              scheduleAction.allowed
                ? "時間會隨草稿或工作副本保存；只有按下「排程」才會生效。 The time is saved with the draft or working copy and takes effect only after Schedule."
                : scheduleAction.reason
            }
          </small><small
            id="editor-schedule-feedback"
            class="editor-schedule-feedback"
            data-editor-schedule-feedback
            data-state={scheduleFeedback.state}
            aria-live="polite"
            aria-atomic="true"
            hidden={!scheduleAction.allowed}>{scheduleFeedback.label}</small
          ></label
        >

        <fieldset id="media" class="media-upload">
          <legend>封面媒體 <small>Cover</small></legend>
          <input
            name="heroMediaId"
            type="hidden"
            value={post?.heroMediaId ?? ""}
          />
          <label
            ><span
              >圖片 <small>PNG / JPEG, max {mediaLimitMebibytes} MiB</small
              ></span
            ><input
              data-media-file
              type="file"
              accept={MEDIA_UPLOAD_MIME_TYPES.join(",")}
            /></label
          >
          <label
            ><span>替代文字 <small>Alt text</small></span><input
              data-media-alt
              maxlength={MEDIA_UPLOAD_LIMITS.altText}
              placeholder="描述圖片內容"
            /></label
          >
          <p
            class="media-selection-feedback"
            data-media-selection-feedback
            data-state="empty"
            aria-live="polite"
            aria-atomic="true"
          >
            尚未選擇待上傳圖片。 No upload selected.
          </p>
          <button
            class="studio-button studio-button--quiet"
            type="button"
            data-upload-media
            disabled>上傳圖片 Upload</button
          >
          <button
            class="studio-button studio-button--quiet"
            type="button"
            data-clear-media
            disabled={!post?.heroMediaId}>清除封面 Clear cover</button
          >
          <p data-media-state aria-live="polite">
            {
              post?.heroMediaId
