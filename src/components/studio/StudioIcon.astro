---
type IconName =
  | "article"
  | "dashboard"
  | "edition"
  | "media"
  | "note"
  | "preview"
  | "save"
  | "send"
  | "source";

interface Props {
  name: IconName;
}

const { name } = Astro.props;
---

<svg class="studio-icon" viewBox="0 0 24 24" aria-hidden="true">
  {
    name === "dashboard" && (
      <>
        <path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h6v6h-6z" />
      </>
    )
  }
  {
    name === "note" && (
      <>
        <path d="m4 16.5-.5 4 4-.5L19 8.5 15.5 5z" />
        <path d="m13.8 6.7 3.5 3.5" />
      </>
    )
  }
  {
    name === "article" && (
      <>
        <path d="M6 3h8l4 4v14H6z" />
        <path d="M14 3v5h4M9 12h6M9 16h6" />
      </>
    )
  }
  {
    name === "media" && (
      <>
        <rect x="3" y="4" width="18" height="16" rx="2" />
        <circle cx="9" cy="9" r="1.5" />
        <path d="m5.5 18 4.8-5 3.2 3 2.3-2.3 2.7 4.3" />
      </>
    )
  }
  {
    name === "source" && (
      <>
        <path d="M5 5h14v4H5zM5 11h14v4H5zM5 17h14v2H5z" />
        <path d="M8 7h.01M8 13h.01" />
      </>
    )
  }
  {
    name === "edition" && (
      <>
        <path d="M5 4h11l3 3v13H5zM16 4v4h3" />
        <path d="M8 11h8M8 14h8M8 17h5" />
      </>
    )
  }
  {
    name === "preview" && (
      <>
        <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z" />
        <circle cx="12" cy="12" r="2.5" />
      </>
    )
  }
  {
    name === "save" && (
      <>
        <path d="M5 3h11l3 3v15H5z" />
        <path d="M8 3v6h8V3M8 21v-7h8v7" />
      </>
    )
  }
  {
    name === "send" && (
      <>
        <path d="m3 11 18-8-7 18-3.5-7.5z" />
        <path d="M10.5 13.5 21 3" />
      </>
    )
  }
</svg>

<style>
  .studio-icon {
    width: 1.35rem;
    height: 1.35rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }
</style>
