---
import { mobileNavigation } from "../config/navigation";
import { isActivePath } from "../lib/navigation";
import NavIcon from "./NavIcon.astro";

interface Props {
  pathname: string;
}

const { pathname } = Astro.props;
---

<nav class="bottom-nav" aria-label="流動版導覽 Mobile navigation">
  {
    mobileNavigation.map((item) => (
      <a
        class:list={[
          "bottom-nav__link",
          { "is-active": isActivePath(pathname, item.href) },
        ]}
        href={item.href}
        aria-label={`${item.label} ${item.labelEn}`}
        aria-current={isActivePath(pathname, item.href) ? "page" : undefined}
      >
        <NavIcon name={item.icon} />
        <span>{"mobileLabel" in item ? item.mobileLabel : item.label}</span>
        <small lang="en">{item.labelEn}</small>
      </a>
    ))
  }
</nav>

<style>
  .bottom-nav {
    display: none;
  }

  @media (max-width: 47.99rem) {
    .bottom-nav {
      position: fixed;
      z-index: var(--z-navigation);
      right: var(--space-3);
      bottom: max(var(--space-2), env(safe-area-inset-bottom));
      left: var(--space-3);
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      padding: var(--space-2);
      border: 1px solid var(--space-border-strong);
      border-radius: var(--radius-lg);
      background: rgba(250, 250, 255, 0.9);
      box-shadow: 0 18px 44px rgba(62, 75, 132, 0.16);
      backdrop-filter: blur(20px);
    }

    .bottom-nav__link {
      display: flex;
      min-width: 0;
      min-height: 3rem;
      align-items: center;
      justify-content: center;
      flex-direction: column;
      gap: var(--space-1);
      border-radius: var(--radius-md);
      color: var(--space-ink-muted);
      font-size: 0.68rem;
      font-weight: 650;
      text-decoration: none;
    }

    .bottom-nav__link.is-active {
      background: linear-gradient(
        135deg,
        var(--space-surface-yellow),
        var(--space-surface-primary)
      );
      color: var(--space-ink);
      box-shadow: var(--space-shadow-glow);
    }

    .bottom-nav__link small {
      font-size: 0.58rem;
      font-weight: 500;
    }

    .bottom-nav__link.is-active :global(.nav-icon) {
      stroke-width: 2.1;
    }
  }
</style>
