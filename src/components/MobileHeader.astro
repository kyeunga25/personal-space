---
import { SITE } from "../config/site";
import BrandMark from "./BrandMark.astro";
import NavIcon from "./NavIcon.astro";
---

<header class="mobile-header">
  <a
    class="mobile-header__brand"
    href="/"
    aria-label={`${SITE.name} 首頁 Home`}
  >
    <BrandMark compact />
    <span>
      <strong>我的空間</strong>
      <small lang="en">My Space</small>
    </span>
  </a>
  <a class="mobile-header__search" href="/search" aria-label="搜尋 Search">
    <NavIcon name="search" />
  </a>
</header>

<style>
  .mobile-header {
    display: none;
  }

  @media (max-width: 47.99rem) {
    .mobile-header {
      position: sticky;
      z-index: var(--z-navigation);
      top: 0;
      display: flex;
      min-height: 4rem;
      align-items: center;
      justify-content: space-between;
      padding: var(--space-2) var(--page-gutter);
      border-bottom: 1px solid var(--space-border);
      background: rgba(239, 249, 255, 0.9);
      backdrop-filter: blur(14px);
    }

    .mobile-header__brand {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      color: var(--space-ink);
      font-size: var(--font-size-0);
      font-weight: 750;
      text-decoration: none;
    }

    .mobile-header__brand > span,
    .mobile-header__brand strong,
    .mobile-header__brand small {
      display: block;
    }

    .mobile-header__brand strong {
      letter-spacing: -0.025em;
    }

    .mobile-header__brand small {
      margin-top: 0.08rem;
      color: var(--space-blue-strong);
      font-size: 0.7rem;
      font-weight: 620;
    }

    .mobile-header__search {
      display: grid;
      width: 2.75rem;
      height: 2.75rem;
      place-items: center;
      border-radius: 50%;
      color: var(--space-ink);
      text-decoration: none;
    }

    .mobile-header__search:hover {
      background: var(--space-surface-primary);
      color: var(--space-primary-strong);
    }
  }
</style>
