---
import { primaryNavigation } from "../config/navigation";
import { SITE } from "../config/site";
import { isActivePath } from "../lib/navigation";
import BrandMark from "./BrandMark.astro";
import NavIcon from "./NavIcon.astro";

interface Props {
  pathname: string;
}

const { pathname } = Astro.props;
---

<aside class="site-rail" aria-label="主要導覽 Primary navigation">
  <a class="site-rail__brand" href="/" aria-label={`${SITE.name} 首頁 Home`}>
    <BrandMark />
    <span>
      <strong>{SITE.name}</strong>
      <small>{SITE.domain}</small>
    </span>
  </a>

  <nav class="site-rail__navigation" aria-label="閱讀導覽 Reading navigation">
    <ul>
      {
        primaryNavigation.map((item) => (
          <li>
            <a
              class:list={[
                "site-rail__link",
                { "is-active": isActivePath(pathname, item.href) },
              ]}
              href={item.href}
              aria-current={
                isActivePath(pathname, item.href) ? "page" : undefined
              }
            >
              <NavIcon name={item.icon} />
              <span class="site-rail__label">
                <span>{item.label}</span>
                <small lang="en">{item.labelEn}</small>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="site-rail__footer">
    <span class="status-light" aria-hidden="true"></span>
    <span>Clear Sky <small lang="en">v0.3.0</small></span>
  </div>
</aside>

<style>
  .site-rail {
    position: sticky;
    top: 0;
    display: flex;
    height: 100svh;
    flex-direction: column;
    overflow-y: auto;
    padding: var(--space-6) var(--space-5);
    border-right: 1px solid var(--space-border-strong);
    background:
      radial-gradient(
        circle at 10% 92%,
        rgba(242, 183, 24, 0.16),
        transparent 13rem
      ),
      rgba(237, 249, 255, 0.64);
    backdrop-filter: blur(20px);
  }

  .site-rail__brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--space-ink);
    text-decoration: none;
  }

  .site-rail__brand span {
    min-width: 0;
  }

  .site-rail__brand strong,
  .site-rail__brand small {
    display: block;
  }

  .site-rail__brand strong {
    font-size: var(--font-size-1);
    letter-spacing: -0.035em;
  }

  .site-rail__brand small {
    margin-top: var(--space-1);
    overflow: hidden;
    color: var(--space-primary-strong);
    font-size: var(--font-size--1);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .site-rail__navigation {
    margin-top: var(--space-7);
  }

  ul {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-rail__link {
    display: flex;
    min-height: 3.15rem;
    align-items: center;
    gap: var(--space-3);
    padding: 0 var(--space-3);
    border-radius: var(--radius-md);
    color: var(--space-ink);
    font-size: var(--font-size-0);
    font-weight: 600;
    text-decoration: none;
    transition:
      color var(--motion-fast) ease,
      background-color var(--motion-fast) ease,
      transform var(--motion-fast) ease;
  }

  .site-rail__link:hover {
    background: var(--space-surface-hover);
    color: var(--space-primary-strong);
    transform: translateX(2px);
  }

  .site-rail__link.is-active {
    background: linear-gradient(
      135deg,
      var(--space-primary),
      var(--space-blue)
    );
    color: #ffffff;
    box-shadow: var(--space-shadow-glow);
  }

  .site-rail__label,
  .site-rail__label span,
  .site-rail__label small {
    display: block;
  }

  .site-rail__link.is-active .site-rail__label small {
    color: rgba(255, 255, 255, 0.78);
  }

  .site-rail__label small {
    margin-top: 0.08rem;
    color: var(--space-ink-faint);
    font-size: 0.68rem;
    font-weight: 500;
  }

  .site-rail__footer {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: auto;
    padding-top: var(--space-4);
    border-top: 1px solid var(--space-border);
    color: var(--space-ink-faint);
    font-size: var(--font-size--1);
  }

  .status-light {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--space-yellow);
    box-shadow: 0 0 0 0.22rem var(--space-surface-yellow);
  }

  @media (max-width: 47.99rem) {
    .site-rail {
      display: none;
    }
  }
</style>
