---
interface Props {
  avatar?: boolean;
  compact?: boolean;
}

const { avatar = false, compact = false } = Astro.props;
---

<span
  class:list={[
    "brand-mark",
    { "brand-mark--avatar": avatar, "brand-mark--compact": compact },
  ]}
>
  <svg viewBox="0 0 32 32" aria-hidden="true">
    <path
      class="brand-mark__star"
      d="M12.1 4.1c.45 3.95 2.2 6.05 6.1 7.9-3.9 1.85-5.65 3.95-6.1 7.9-.45-3.95-2.2-6.05-6.1-7.9 3.9-1.85 5.65-3.95 6.1-7.9Z"
    ></path>
    <path
      class="brand-mark__orbit"
      d="M4.2 20.5c1.8 4 8.7 4.8 15.6 1.7 6.9-3.1 11.1-8.8 9.3-12.8-1-2.3-3.8-3.4-7.2-3.2"
    ></path>
    <circle class="brand-mark__core" cx="22.4" cy="20.7" r="2.15"></circle>
    <path
      class="brand-mark__spark"
      d="M25.5 23.8c.23 2.05 1.14 3.14 3.16 4.1-2.02.96-2.93 2.05-3.16 4.1-.23-2.05-1.14-3.14-3.16-4.1 2.02-.96 2.93-2.05 3.16-4.1Z"
    ></path>
  </svg>
</span>

<style>
  .brand-mark {
    display: inline-grid;
    width: 3rem;
    height: 3rem;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid rgba(117, 128, 190, 0.16);
    border-radius: 50%;
    background: var(--space-surface-strong);
    box-shadow: 0 10px 26px rgba(75, 88, 146, 0.08);
  }

  .brand-mark--compact {
    width: 2.5rem;
    height: 2.5rem;
  }

  svg {
    width: 2.6rem;
    height: 2.6rem;
    overflow: visible;
  }

  .brand-mark--compact svg {
    width: 2.2rem;
    height: 2.2rem;
  }

  .brand-mark--avatar {
    width: clamp(7rem, 11vw, 8.75rem);
    height: clamp(7rem, 11vw, 8.75rem);
    border-width: 1px;
    border-color: var(--space-primary-soft);
    box-shadow:
      0 0 0 0.45rem rgba(255, 255, 255, 0.58),
      0 0 0 0.6rem rgba(143, 153, 218, 0.12),
      var(--space-shadow-glow);
  }

  .brand-mark--avatar svg {
    width: 72%;
    height: 72%;
  }

  .brand-mark__star {
    fill: var(--space-yellow);
  }

  .brand-mark__orbit {
    fill: none;
    stroke: var(--space-primary);
    stroke-linecap: round;
    stroke-width: 1.2;
  }

  .brand-mark__core {
    fill: var(--space-primary);
  }

  .brand-mark__spark {
    fill: var(--space-teal);
  }
</style>
