---
import NavIcon from "./NavIcon.astro";

const contentGroups = [
  {
    href: "/notes",
    icon: "note",
    className: "short",
    label: "筆記",
    labelEn: "Notes",
    types: "Short thoughts · Updates",
  },
  {
    href: "/articles",
    icon: "article",
    className: "longform",
    label: "文章",
    labelEn: "Articles",
    types: "Essays · Reviews · Guides",
  },
  {
    href: "/stream",
    icon: "stream",
    className: "briefing",
    label: "動態",
    labelEn: "Stream",
    types: "Newest · Chronological",
  },
] as const;
---

<aside class="context-rail" aria-label="內容地圖 Content map">
  <section class="context-card context-card--map">
    <h2>
      內容地圖 <small lang="en">Content map</small>
      <span class="context-card__spark" aria-hidden="true"></span>
    </h2>
    <ul>
      {
        contentGroups.map((group) => (
          <li>
            <a href={group.href}>
              <span
                class:list={[
                  "context-link__icon",
                  `context-link__icon--${group.className}`,
                ]}
                aria-hidden="true"
              >
                <NavIcon name={group.icon} />
              </span>
              <span class="context-link__copy">
                <strong>
                  {group.label} <small lang="en">{group.labelEn}</small>
                </strong>
                <span lang="en">{group.types}</span>
              </span>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="m9 5 7 7-7 7" />
              </svg>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="context-card context-card--status">
    <h2>現在 <small lang="en">Now</small></h2>
    <div class="status-panel">
      <span class="status-panel__dot" aria-hidden="true"></span>
      <p>
        持續整理中
        <small lang="en">In progress</small>
      </p>
      <span class="status-panel__orbit" aria-hidden="true"></span>
      <span class="status-panel__rhythm" aria-hidden="true"></span>
    </div>
  </section>
</aside>

<style>
  .context-rail {
    position: sticky;
    top: 0;
    display: grid;
    height: 100svh;
    grid-auto-rows: max-content;
    align-content: start;
    gap: var(--space-5);
    overflow-y: auto;
    padding: var(--space-7) var(--space-5);
    border-left: 1px solid var(--space-border-strong);
    background: rgba(237, 249, 255, 0.62);
    backdrop-filter: blur(20px);
  }

  .context-card {
    overflow: hidden;
    padding: var(--space-5);
    border: 1px solid var(--space-border-strong);
    border-radius: var(--radius-lg);
    background: var(--space-surface);
    box-shadow: var(--space-shadow-soft);
    backdrop-filter: blur(16px);
  }

  h2 {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: calc(var(--space-5) * -1) calc(var(--space-5) * -1) 0;
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--space-border);
    background: linear-gradient(
      135deg,
      rgba(218, 241, 255, 0.78),
      rgba(255, 250, 225, 0.54)
    );
    color: var(--space-ink);
    font-size: var(--font-size-1);
    letter-spacing: -0.02em;
  }

  h2 small {
    color: var(--space-blue-strong);
    font-size: var(--font-size--1);
    font-weight: 570;
  }

  .context-card__spark {
    width: 1rem;
    height: 1rem;
    margin-left: auto;
    background: var(--space-yellow);
    clip-path: polygon(
      50% 0,
      61% 39%,
      100% 50%,
      61% 61%,
      50% 100%,
      39% 61%,
      0 50%,
      39% 39%
    );
  }

  ul {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: grid;
    min-height: 7.2rem;
    grid-template-columns: 3.4rem minmax(0, 1fr) 1.1rem;
    gap: var(--space-3);
    align-items: center;
    border-bottom: 1px solid var(--space-border);
    color: var(--space-ink);
    text-decoration: none;
    transition:
      color var(--motion-fast) ease,
      background-color var(--motion-fast) ease;
  }

  li:last-child a {
    border-bottom: 0;
  }

  a:hover {
    color: var(--space-primary-strong);
    background: rgba(220, 242, 255, 0.48);
  }

  a > svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
  }

  .context-link__icon {
    display: grid;
    width: 3.15rem;
    height: 3.15rem;
    place-items: center;
    border: 1px solid var(--space-primary-soft);
    border-radius: var(--radius-md);
    background: var(--space-surface-primary);
    color: var(--space-primary);
    clip-path: polygon(
      0.45rem 0,
      100% 0,
      100% calc(100% - 0.45rem),
      calc(100% - 0.45rem) 100%,
      0 100%
    );
  }

  .context-link__icon--longform {
    border-color: var(--space-blue-soft);
    background: var(--space-surface-blue);
    color: var(--space-blue);
  }

  .context-link__icon--briefing {
    border-color: var(--space-teal-soft);
    background: var(--space-surface-teal);
    color: var(--space-teal);
  }

  .context-link__icon :global(.nav-icon) {
    width: 1.35rem;
    height: 1.35rem;
  }

  .context-link__copy,
  .context-link__copy strong,
  .context-link__copy > span {
    display: block;
    min-width: 0;
  }

  .context-link__copy strong {
    font-size: var(--font-size-0);
    font-weight: 720;
  }

  .context-link__copy strong small {
    color: var(--space-ink-faint);
    font-size: 0.7rem;
    font-weight: 540;
  }

  .context-link__copy > span {
    margin-top: var(--space-2);
    color: var(--space-ink-muted);
    font-size: 0.72rem;
    line-height: 1.4;
  }

  .status-panel {
    position: relative;
    display: grid;
    min-height: 9rem;
    grid-template-columns: auto 1fr;
    gap: var(--space-3);
    align-items: start;
    margin-top: var(--space-4);
    padding: var(--space-5);
    overflow: hidden;
    border: 1px solid rgba(46, 169, 131, 0.28);
    border-radius: var(--radius-md);
    background: linear-gradient(
      145deg,
      var(--space-surface-mint),
      rgba(232, 244, 255, 0.64)
    );
  }

  .status-panel__dot {
    width: 0.55rem;
    height: 0.55rem;
    margin-top: 0.45rem;
    border-radius: 50%;
    background: var(--space-mint);
    box-shadow: 0 0 0 0.25rem rgba(46, 169, 131, 0.12);
  }

  .status-panel p {
    position: relative;
    z-index: 2;
    margin: 0;
    color: var(--space-ink);
    font-size: var(--font-size-0);
    font-weight: 680;
  }

  .status-panel p small {
    display: block;
    margin-top: var(--space-1);
    color: var(--space-ink-muted);
    font-size: var(--font-size--1);
    font-weight: 520;
  }

  .status-panel__orbit {
    position: absolute;
    right: 1rem;
    bottom: -1.1rem;
    width: 6.5rem;
    height: 4rem;
    border: 1.5px solid var(--space-primary);
    border-radius: 50%;
    opacity: 0.55;
    transform: rotate(-24deg);
  }

  .status-panel__rhythm {
    position: absolute;
    right: 0.8rem;
    bottom: 0.75rem;
    width: 4rem;
    height: 2.25rem;
    background: repeating-linear-gradient(
      to right,
      rgba(63, 146, 239, 0.28) 0 0.2rem,
      transparent 0.2rem 0.4rem
    );
    clip-path: polygon(
      0 80%,
      15% 45%,
      30% 70%,
      45% 10%,
      60% 50%,
      75% 25%,
      90% 65%,
      100% 40%,
      100% 100%,
      0 100%
    );
  }

  @media (max-width: 68.74rem) {
    .context-rail {
      display: none;
    }
  }
</style>
