---
import type { PlaceholderRoute } from "../config/route-content";
import BaseLayout from "../layouts/BaseLayout.astro";

type Props = PlaceholderRoute;

const { title, description } = Astro.props;
---

<BaseLayout
  title={title.zhHant}
  titleEn={title.en}
  description={description.zhHant}
  descriptionEn={description.en}
  section={title.zhHant}
  sectionEn={title.en}
>
  <div class="page-stack">
    <header class="route-header">
      <h1>{title.zhHant} <small lang="en">{title.en}</small></h1>
      <p>{description.zhHant}</p>
      <p class="en-subline" lang="en">{description.en}</p>
      <div class="button-row">
        <a class="button button--primary" href="/"
          >返回首頁 <span lang="en">Home</span></a
        >
        {
          title.en !== "Shorts" && (
            <a class="button" href="/shorts">
              瀏覽短內容 <span lang="en">Shorts</span>
            </a>
          )
        }
      </div>
    </header>

    <section class="route-empty" aria-labelledby="empty-heading">
      <h2 id="empty-heading">
        暫未有公開內容 <small lang="en">No public entries yet</small>
      </h2>
      <p>這個分類目前保持安靜；有適合公開的內容時會在這裡出現。</p>
      <p class="en-subline" lang="en">
        This section is quiet for now. Public entries will appear here when
        available.
      </p>
    </section>
  </div>
</BaseLayout>
