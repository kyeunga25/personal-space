---
import { formatHongKongDate } from "../lib/dates";
import { buildPostTaxonomyLinks } from "../lib/navigation";
import { getPublicPostDisplayTitle } from "../lib/post-display";
import { getReadingTime } from "../lib/reading-time";
import type { PostRecord } from "../server/publishing/domain";
import ReadingTimeLabel from "./ReadingTimeLabel.astro";

interface Props {
  emptyDescription?: string;
  emptyDescriptionEn?: string;
  emptyTitle?: string;
  emptyTitleEn?: string;
  nextHref?: string | null;
  posts: PostRecord[];
}

const {
  emptyDescription = "目前沒有符合條件的公開內容。",
  emptyDescriptionEn = "No public entries match the current view.",
  emptyTitle = "找不到內容",
  emptyTitleEn = "No matching entries",
  nextHref = null,
  posts,
} = Astro.props;
---

<section class="discovery-results" aria-live="polite">
  {
    posts.length === 0 ? (
      <div class="discovery-results__empty">
        <h2>
          {emptyTitle} <small lang="en">{emptyTitleEn}</small>
        </h2>
        <p>{emptyDescription}</p>
        <p class="en-subline" lang="en">
          {emptyDescriptionEn}
        </p>
      </div>
    ) : (
      <ol>
        {posts.map((post) => {
          const href = `/${post.kind === "note" ? "notes" : "articles"}/${encodeURIComponent(post.slug ?? "")}`;
          const displayTitle = getPublicPostDisplayTitle(post);
          const taxonomyLinks = buildPostTaxonomyLinks(
            post.category,
            post.tags,
          );
          return (
            <li>
              <article
                class:list={["discovery-row", `discovery-row--${post.kind}`]}
              >
                <a class="discovery-row__main" href={href}>
                  <span class="discovery-row__meta">
                    <span class="discovery-row__kind">
                      {post.kind === "note" ? "筆記" : "文章"}
                      <span lang="en">
                        {post.kind === "note" ? "Note" : "Article"}
                      </span>
                    </span>
                    <span class="discovery-row__details">
                      <time
                        datetime={
                          post.publishedAt ?? post.scheduledAt ?? undefined
                        }
                      >
                        {formatHongKongDate(
                          post.publishedAt ?? post.scheduledAt,
                        )}
                      </time>
                      {post.kind === "article" && (
                        <span>
                          <ReadingTimeLabel
                            readingTime={getReadingTime(post.bodyMd)}
                          />
                        </span>
                      )}
                    </span>
                  </span>
                  <strong>{displayTitle}</strong>
                  {post.title && post.excerpt && (
                    <span class="discovery-row__excerpt">{post.excerpt}</span>
                  )}
                </a>
                {taxonomyLinks.length > 0 && (
                  <ul
                    class="discovery-row__taxonomy"
                    aria-label="分類與標籤 Categories and tags"
                  >
                    {taxonomyLinks.map((item) => (
                      <li>
                        {item.href ? (
                          <a href={item.href} aria-label={item.accessibleLabel}>
                            {item.label}
                          </a>
                        ) : (
                          <span>
                            <span class="visually-hidden">
                              {item.accessibleLabel}
                            </span>
                            <span aria-hidden="true">{item.label}</span>
                          </span>
                        )}
                      </li>
                    ))}
                  </ul>
                )}
              </article>
            </li>
          );
        })}
      </ol>
    )
  }
  {
    nextHref && (
      <div class="discovery-results__more">
        <a class="button" href={nextHref}>
          載入較早內容 <span lang="en">Load older</span>
        </a>
      </div>
    )
  }
</section>

<style>
  .discovery-results ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .discovery-results li {
    border-bottom: 1px solid var(--space-border);
  }

  .discovery-row {
    padding: clamp(1.35rem, 4vw, 2.15rem);
    overflow-wrap: anywhere;
    transition:
      background-color var(--motion-fast) ease,
      box-shadow var(--motion-fast) ease;
  }

  .discovery-row:hover,
  .discovery-row:focus-within {
    background: var(--space-surface-hover);
    box-shadow: inset 3px 0 var(--space-primary);
  }

  .discovery-row--article:hover,
  .discovery-row--article:focus-within {
    box-shadow: inset 3px 0 var(--space-blue);
  }

  .discovery-row__main {
    display: block;
    color: var(--space-ink);
    text-decoration: none;
  }

  .discovery-row__meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    color: var(--space-ink-faint);
    font-size: var(--font-size--1);
  }

  .discovery-row__kind {
    color: var(--space-primary-strong);
    font-weight: 720;
  }

  .discovery-row__kind span {
    margin-left: 0.35em;
    color: var(--space-ink-faint);
    font-size: 0.86em;
  }

  .discovery-row--article .discovery-row__kind {
    color: var(--space-blue-strong);
  }

  .discovery-row__details {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-1) var(--space-3);
    text-align: right;
  }

  .discovery-row__details > span {
    white-space: nowrap;
  }

  .discovery-row strong,
  .discovery-row__excerpt {
    display: block;
  }

  .discovery-row strong {
    margin-top: var(--space-3);
    font-size: var(--font-size-2);
    letter-spacing: -0.025em;
    line-height: 1.3;
  }

  .discovery-row__excerpt {
    display: -webkit-box;
    max-width: 40rem;
    margin-top: var(--space-3);
    overflow: hidden;
    -webkit-box-orient: vertical;
    color: var(--space-ink-muted);
    -webkit-line-clamp: 3;
  }

  .discovery-row__taxonomy {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    margin: var(--space-4) 0 0;
    padding: 0;
    font-size: var(--font-size--1);
    list-style: none;
  }

  .discovery-row__taxonomy a,
  .discovery-row__taxonomy span {
    color: var(--space-teal-strong);
    font-weight: 650;
  }

  .discovery-row__taxonomy a {
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .discovery-results__empty,
  .discovery-results__more {
    padding: clamp(1.5rem, 4vw, 2.25rem);
  }

  .discovery-results__empty h2 {
    margin: 0;
    font-size: var(--font-size-2);
  }

  .discovery-results__empty p {
    margin: var(--space-3) 0 0;
    color: var(--space-ink-muted);
  }

  .discovery-results__more {
    display: flex;
    justify-content: center;
    border-top: 1px solid var(--space-border);
  }

  @media (max-width: 47.99rem) {
    .discovery-row strong {
      font-size: var(--font-size-1);
    }
  }
</style>
