---
import DiscoveryPostList from "../components/DiscoveryPostList.astro";
import ProfileHeader from "../components/ProfileHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { parseDiscoveryFilters } from "../server/discovery/filters";
import { getBindings } from "../server/platform/bindings";
import { D1PublishingRepository } from "../server/publishing/repository";

const repository = new D1PublishingRepository(getBindings().DB);
const result = await repository.listPublicDiscovery(
  parseDiscoveryFilters(new URLSearchParams(), 20),
  new Date().toISOString(),
);
---

<BaseLayout section="首頁" sectionEn="Home">
  <ProfileHeader pathname={Astro.url.pathname} />
  <section class="home-feed" aria-labelledby="highlights-heading">
    <h2 id="highlights-heading" class="visually-hidden">最新內容 Latest</h2>
    <DiscoveryPostList
      posts={result.posts}
      emptyTitle="這裡準備好了"
      emptyTitleEn="This space is ready"
      emptyDescription="公開筆記或文章發佈後，會按時間顯示在這裡。"
      emptyDescriptionEn="Published notes or articles will appear here chronologically."
    />
  </section>
</BaseLayout>

<style>
  .home-feed {
    min-height: 24rem;
  }
</style>
