---
import PostDetailPage from "../../components/PostDetailPage.astro";
import PublicNotFoundPage from "../../components/PublicNotFoundPage.astro";
import { getBindings } from "../../server/platform/bindings";
import { D1PublishingRepository } from "../../server/publishing/repository";

const slug = Astro.params.slug ?? "";
const repository = new D1PublishingRepository(getBindings().DB);
const post = slug
  ? await repository.findPublicPost("article", slug, new Date().toISOString())
  : null;
if (!post) Astro.response.status = 404;
const media = post?.heroMediaId
  ? await repository.findMedia(post.heroMediaId)
  : null;
---

{
  post ? (
    <PostDetailPage {post} {media} />
  ) : (
    <PublicNotFoundPage kind="article" />
  )
}
