---
import StudioLayout from "../../../layouts/StudioLayout.astro";
import { formatHongKongDate } from "../../../lib/dates";
import {
  formatAutomationError,
  formatAutomationJob,
  formatAutomationRunStatus,
  formatAutomationRunSummary,
  formatAutomationTrigger,
  formatSourceError,
  formatSourceReviewStatus,
  formatSourceStatus,
} from "../../../lib/edition-status";
import { PUBLIC_HTTPS_URL_MAX_LENGTH } from "../../../lib/public-https-url";
import {
  automationRunPageHref,
  parseAutomationRunPageCursor,
} from "../../../server/editions/automation-run-pagination";
import { D1EditionRepository } from "../../../server/editions/repository";
import {
  parseSourcePageCursor,
  sourceLatestHref,
  sourcePageHref,
} from "../../../server/editions/source-pagination";
import { getBindings } from "../../../server/platform/bindings";

const repository = new D1EditionRepository(getBindings().DB);
const automationRunCursor = parseAutomationRunPageCursor(
  Astro.url.searchParams,
);
const sourceCursor = parseSourcePageCursor(Astro.url.searchParams);
const [sourcePage, automationRunPage] = await Promise.all([
  repository.listSourcePage(sourceCursor),
  repository.listAutomationRunPage(automationRunCursor),
]);
const automationRuns = automationRunPage.runs;
const nextAutomationRunHref = automationRunPage.nextCursor
  ? automationRunPageHref(automationRunPage.nextCursor)
  : null;
const sources = sourcePage.sources;
const nextSourceHref = sourcePage.nextCursor
  ? sourcePageHref(sourcePage.nextCursor)
  : null;
---

<StudioLayout title="來源管理">
  <div class="source-workspace">
    <header class="source-header">
      <div>
        <p class="eyebrow">私人工作區 · Owner only</p>
        <h1>來源 <small lang="en">Sources</small></h1>
        <p>加入已核對使用條款的 HTTPS RSS／Atom feed；系統每日同步兩次。</p>
      </div>
      <button class="button button--primary" type="button" data-ingest-now>
        立即同步 <span lang="en">Sync now</span>
      </button>
    </header>

    <p class="source-status" aria-live="polite" data-source-status></p>

    <aside class="rights-notice">
      <strong>權利審核 · Rights review</strong>
      <p>
        僅在已核對來源條款、引用方式及署名要求後標記為已核准。系統只保存必要的標題、短摘要與原文連結，不應重新發佈第三方全文。
      </p>
    </aside>

    <section class="source-panel" aria-labelledby="new-source-heading">
      <h2 id="new-source-heading">新增來源 <small>Add source</small></h2>
      <p class="source-help" id="source-url-requirements">
        網址：僅支援公開 HTTPS 網址，最多 2,048
        個字元；不可包含登入資料、私人主機或非標準連接埠。 <span lang="en"
          >URLs: Public HTTPS URLs only, up to 2,048 characters; no credentials,
          private hosts, or non-standard ports.</span
        >
      </p>
      <form
        class="source-form"
        method="post"
        action="/api/studio/sources"
        data-source-form
      >
        <label
          >名稱 <small>Name</small><input
            name="name"
            maxlength="120"
            required
          /></label
        >
        <label>
          Feed URL
          <input
            name="feedUrl"
            type="url"
            inputmode="url"
            maxlength={PUBLIC_HTTPS_URL_MAX_LENGTH}
            aria-describedby="source-url-requirements"
            aria-errormessage="new-source-feed-url-error"
            data-source-url
            placeholder="https://example.com/feed.xml"
            required
          />
          <small
            class="source-url-error"
            id="new-source-feed-url-error"
            data-source-url-error
            aria-live="polite"
            hidden></small>
        </label>
        <label>
          網站 URL <small>Site URL</small>
          <input
            name="siteUrl"
            type="url"
            inputmode="url"
            maxlength={PUBLIC_HTTPS_URL_MAX_LENGTH}
            aria-describedby="source-url-requirements"
            aria-errormessage="new-source-site-url-error"
            data-source-url
            placeholder="https://example.com/"
          />
          <small
            class="source-url-error"
            id="new-source-site-url-error"
            data-source-url-error
            aria-live="polite"
            hidden></small>
        </label>
        <label>
          條款 URL <small>Terms URL</small>
          <input
            name="termsUrl"
            type="url"
            inputmode="url"
            maxlength={PUBLIC_HTTPS_URL_MAX_LENGTH}
            aria-describedby="source-url-requirements"
            aria-errormessage="new-source-terms-url-error"
            data-source-url
            placeholder="https://example.com/terms"
          />
          <small
            class="source-url-error"
            id="new-source-terms-url-error"
            data-source-url-error
            aria-live="polite"
            hidden></small>
        </label>
        <label class="field--wide"
          >權利依據 <small>Rights basis</small><textarea
            name="rightsBasis"
            rows="3"
            maxlength="600"
            placeholder="記錄可使用 RSS 標題、摘要與連結的依據，以及署名或非商業限制。"
          ></textarea></label
        >
        <label class="field--wide"
          >審核備註 <small>Review notes</small><textarea
            name="reviewNotes"
            rows="2"
            maxlength="1000"></textarea></label
        >
        <label
          >審核 <small>Review</small><select name="reviewStatus"
            ><option value="pending">待審核 Pending</option><option
              value="approved">已核准 Approved</option
            ><option value="rejected">不採用 Rejected</option></select
          ></label
        >
        <label
          >狀態 <small>Status</small><select name="status"
            ><option value="paused">暫停 Paused</option><option value="enabled"
              >啟用 Enabled</option
            ></select
          ></label
        >
        <label class="confirmation field--wide">
          <input name="rightsConfirmed" type="checkbox" />
          <span>我已核對條款及使用權利 · Rights confirmed</span>
        </label>
        <button class="button button--primary" type="submit"
          >加入來源 Add source</button
        >
      </form>
    </section>

    <section class="source-list" aria-labelledby="source-list-heading">
      <header>
        <h2 id="source-list-heading">
          已加入來源 <small>Saved sources</small>
        </h2><span>本頁 {sources.length} <small lang="en">On page</small></span>
      </header>
      {
        sources.length === 0 ? (
          <div class="source-empty">
            <p>
              {sourceCursor
                ? "這個分頁已沒有來源。 This page no longer has sources."
                : "尚未加入來源。 Add a public feed to begin."}
            </p>
            {sourceCursor && (
              <a class="button" href={sourceLatestHref()}>
                返回最新來源 <span lang="en">Return to latest sources</span>
              </a>
            )}
          </div>
        ) : (
          <div class="source-grid">
            {sources.map((source, sourceIndex) => (
              <form
                class="source-card"
                method="post"
                action={`/api/studio/sources/${encodeURIComponent(source.id)}`}
                data-source-form
                data-source-id={source.id}
              >
                <div class="source-card__meta">
                  <strong>{formatSourceStatus(source.status)}</strong>
                  <span>
                    審核 <span lang="en">Review</span>：
                    {formatSourceReviewStatus(source.reviewStatus)}
                  </span>
                  <span>
                    最近同步 <span lang="en">Last sync</span>：
                    {formatHongKongDate(source.lastFetchedAt)}
                  </span>
                  {source.lastErrorCode && (
                    <span class="source-card__error">
                      來源錯誤 <span lang="en">Source error</span>：
                      {formatSourceError(source.lastErrorCode)}
                    </span>
                  )}
                </div>
                <label>
                  名稱{" "}
                  <input
                    name="name"
                    maxlength="120"
                    value={source.name}
                    required
                  />
                </label>
                <label>
                  Feed URL{" "}
                  <input
                    name="feedUrl"
                    type="url"
                    inputmode="url"
                    maxlength={PUBLIC_HTTPS_URL_MAX_LENGTH}
                    aria-describedby="source-url-requirements"
                    aria-errormessage={`saved-source-${sourceIndex}-feed-url-error`}
                    data-source-url
                    value={source.feedUrl}
                    required
                  />
                  <small
                    class="source-url-error"
                    id={`saved-source-${sourceIndex}-feed-url-error`}
                    data-source-url-error
                    aria-live="polite"
                    hidden
                  />
                </label>
                <label>
                  網站 URL{" "}
                  <input
                    name="siteUrl"
                    type="url"
                    inputmode="url"
                    maxlength={PUBLIC_HTTPS_URL_MAX_LENGTH}
                    aria-describedby="source-url-requirements"
                    aria-errormessage={`saved-source-${sourceIndex}-site-url-error`}
                    data-source-url
                    value={source.siteUrl ?? ""}
                  />
                  <small
                    class="source-url-error"
                    id={`saved-source-${sourceIndex}-site-url-error`}
                    data-source-url-error
                    aria-live="polite"
                    hidden
                  />
                </label>
                <label>
                  條款 URL <small>Terms URL</small>
                  <input
                    name="termsUrl"
                    type="url"
                    inputmode="url"
                    maxlength={PUBLIC_HTTPS_URL_MAX_LENGTH}
                    aria-describedby="source-url-requirements"
                    aria-errormessage={`saved-source-${sourceIndex}-terms-url-error`}
                    data-source-url
                    value={source.termsUrl ?? ""}
                  />
                  <small
                    class="source-url-error"
                    id={`saved-source-${sourceIndex}-terms-url-error`}
                    data-source-url-error
                    aria-live="polite"
                    hidden
                  />
                </label>
                <label>
                  權利依據 <small>Rights basis</small>
                  <textarea name="rightsBasis" rows="3" maxlength="600">
                    {source.rightsBasis ?? ""}
                  </textarea>
                </label>
                <label>
                  審核備註 <small>Review notes</small>
                  <textarea name="reviewNotes" rows="2" maxlength="1000">
                    {source.reviewNotes ?? ""}
                  </textarea>
                </label>
                <label>
                  審核 <small>Review</small>
                  <select name="reviewStatus">
                    <option
                      value="pending"
                      selected={source.reviewStatus === "pending"}
                    >
                      待審核 Pending
                    </option>
                    <option
                      value="approved"
                      selected={source.reviewStatus === "approved"}
                    >
                      已核准 Approved
                    </option>
                    <option
                      value="rejected"
                      selected={source.reviewStatus === "rejected"}
                    >
                      不採用 Rejected
                    </option>
                  </select>
                </label>
                <label>
                  狀態{" "}
                  <select name="status">
                    <option
                      value="enabled"
                      selected={source.status === "enabled"}
                    >
                      啟用 Enabled
                    </option>
                    <option
                      value="paused"
                      selected={source.status === "paused"}
                    >
                      暫停 Paused
                    </option>
                  </select>
                </label>
                <label class="confirmation">
                  <input
                    name="rightsConfirmed"
                    type="checkbox"
                    checked={source.reviewStatus === "approved"}
                  />
                  <span>我已核對條款及使用權利 · Rights confirmed</span>
                </label>
                <button class="button" type="submit">
                  儲存 Save
                </button>
              </form>
            ))}
          </div>
        )
      }
      {
        nextSourceHref && (
          <nav class="source-more" aria-label="來源分頁 Source pagination">
            <a class="button" href={nextSourceHref}>
              載入較早來源 <span lang="en">Load older sources</span>
            </a>
          </nav>
        )
      }
    </section>

    <section class="run-list" aria-labelledby="run-list-heading">
      <header>
        <h2 id="run-list-heading">執行紀錄 <small>Automation runs</small></h2>
        <span
          >本頁 {automationRuns.length} <small lang="en">On page</small></span
        >
      </header>
      {
        automationRuns.length === 0 ? (
          <div class="source-empty">
            <p>
              {automationRunCursor
                ? "這個分頁已沒有執行紀錄。 This page no longer has automation runs."
                : "尚未有自動化執行紀錄。 No automation runs yet."}
            </p>
            {automationRunCursor && (
              <a class="button" href="/studio/sources#run-list-heading">
                返回最新紀錄 <span lang="en">Return to latest runs</span>
              </a>
            )}
          </div>
        ) : (
          <ol>
            {automationRuns.map((run) => (
              <li>
                <div>
                  <strong>{formatAutomationJob(run.job)}</strong>
                  <span data-run-status={run.status}>
                    {formatAutomationRunStatus(run.status)}
                  </span>
                </div>
                <small>
                  {formatHongKongDate(run.scheduledAt)} ·{" "}
                  {formatAutomationTrigger(run.trigger)} · 嘗試{" "}
                  <span lang="en">Attempts</span>：{run.attemptCount}
                </small>
                {Object.keys(run.summary).length > 0 && (
                  <p>{formatAutomationRunSummary(run.summary)}</p>
                )}
                {run.errorCode && (
                  <p class="source-card__error">
                    執行錯誤 <span lang="en">Run error</span>：
                    {formatAutomationError(run.errorCode)}
                  </p>
                )}
              </li>
            ))}
          </ol>
        )
      }
      {
        nextAutomationRunHref && (
          <nav
            class="source-more"
            aria-label="執行紀錄分頁 Automation run pagination"
          >
            <a class="button" href={nextAutomationRunHref}>
              載入較早紀錄 <span lang="en">Load older runs</span>
            </a>
          </nav>
        )
      }
    </section>
  </div>
</StudioLayout>

<script>
  import "../../../scripts/studio-sources";
</script>

<style>
  .source-workspace {
    width: min(100%, 76rem);
    margin-inline: auto;
    padding: clamp(1.5rem, 5vw, 4rem);
  }
  .source-header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-5);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--space-border-strong);
  }
  .eyebrow {
    margin: 0 0 var(--space-2);
    color: var(--space-primary-strong);
    font-size: var(--font-size--1);
    font-weight: 720;
  }
  h1 {
    margin: 0;
    font-size: var(--font-size-4);
    letter-spacing: -0.05em;
  }
  h1 small,
  h2 small {
    color: var(--space-primary);
    font-size: 0.55em;
  }
  .source-header p:not(.eyebrow) {
    margin: var(--space-3) 0 0;
    color: var(--space-ink-muted);
  }
  .source-status {
    min-height: 1.5rem;
    margin: var(--space-4) 0;
    color: var(--space-teal-strong);
    font-weight: 650;
  }
  .source-status[data-state="error"],
  .source-card__error {
    color: #a23b3b;
  }
  .source-panel,
  .source-list,
  .run-list {
    overflow: hidden;
    border: 1px solid var(--space-border-strong);
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.7);
  }
  .rights-notice {
    margin-bottom: var(--space-5);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--space-border-strong);
    border-radius: var(--radius-md);
    background: var(--space-surface-blue);
    color: var(--space-ink-muted);
  }
  .rights-notice strong {
    color: var(--space-primary-strong);
  }
  .rights-notice p {
    margin: var(--space-2) 0 0;
  }
  .source-panel {
    padding: var(--space-5);
  }
  h2 {
    margin: 0;
    font-size: var(--font-size-2);
  }
  .source-help {
    margin: var(--space-3) 0 0;
    color: var(--space-ink-muted);
    font-size: var(--font-size--1);
    line-height: 1.65;
  }
  .source-form {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    align-items: end;
    margin-top: var(--space-4);
  }
  .source-form .field--wide {
    grid-column: 1 / -1;
  }
  label {
    display: grid;
    gap: var(--space-2);
    color: var(--space-ink-muted);
    font-size: var(--font-size--1);
    font-weight: 680;
  }
  label small {
    color: var(--space-ink-faint);
  }
  input,
  select,
  textarea {
    width: 100%;
    min-height: 2.75rem;
    padding: 0.6rem 0.7rem;
    border: 1px solid var(--space-border-strong);
    border-radius: var(--radius-sm);
    background: white;
    color: var(--space-ink);
  }
  input[aria-invalid="true"] {
    border-color: #a23b3b;
  }
  .source-url-error {
    color: #a23b3b;
    font-weight: 620;
    line-height: 1.5;
  }
  textarea {
    resize: vertical;
  }
  .confirmation {
    display: flex;
    grid-template-columns: none;
    flex-direction: row;
    align-items: center;
    gap: var(--space-3);
  }
  .confirmation input {
    width: 1.15rem;
    min-height: 1.15rem;
  }
  .source-list {
    margin-top: var(--space-6);
  }
  .run-list {
    margin-top: var(--space-6);
  }
  .source-list > header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--space-border);
    background: var(--space-surface-blue);
  }
  .source-list > header span {
    color: var(--space-primary-strong);
    font-weight: 750;
  }
  .source-list > header small {
    color: var(--space-ink-faint);
    font-size: 0.72em;
  }
  .run-list > header {
    display: flex;
    justify-content: space-between;
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--space-border);
    background: var(--space-surface-blue);
  }
  .run-list ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .run-list li {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--space-border);
  }
  .run-list li:last-child {
    border-bottom: 0;
  }
  .run-list li > div {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .run-list p {
    margin: 0;
    color: var(--space-ink-muted);
  }
  [data-run-status="succeeded"] {
    color: var(--space-teal-strong);
  }
  [data-run-status="failed"],
  [data-run-status="partial"] {
    color: #a23b3b;
  }
  .source-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--space-border);
  }
  .source-card {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-5);
    background: rgba(255, 255, 255, 0.92);
  }
  .source-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    color: var(--space-ink-faint);
    font-size: var(--font-size--1);
  }
  .source-card__meta strong {
    color: var(--space-teal-strong);
  }
  .source-card .button {
    justify-self: start;
  }
  .source-more {
    display: flex;
    justify-content: center;
    padding: var(--space-4);
    border-top: 1px solid var(--space-border);
  }
  .source-empty {
    display: grid;
    justify-items: center;
    gap: var(--space-4);
    margin: 0;
    padding: var(--space-7);
    color: var(--space-ink-muted);
    text-align: center;
  }
  .source-empty > p {
    margin: 0;
  }
  @media (max-width: 64rem) {
    .source-form {
      grid-template-columns: 1fr 1fr;
    }
    .source-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 47.99rem) {
    .source-workspace {
      padding: var(--space-5) var(--space-4) 7rem;
    }
    .source-header {
      display: block;
    }
    .source-header .button {
      margin-top: var(--space-4);
    }
    h1 {
      font-size: var(--font-size-3);
    }
    .source-form {
      grid-template-columns: 1fr;
    }
  }
</style>
