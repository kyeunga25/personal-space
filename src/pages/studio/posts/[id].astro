---
import EditorForm from "../../../components/studio/EditorForm.astro";
import StudioNotFoundPage from "../../../components/studio/StudioNotFoundPage.astro";
import StudioLayout from "../../../layouts/StudioLayout.astro";
import { getBindings } from "../../../server/platform/bindings";
import { loadStudioPostEditor } from "../../../server/publishing/editor-loader";
import {
  parseRevisionPageCursor,
  revisionLatestHref,
  revisionPageHref,
} from "../../../server/publishing/revision-pagination";
import { D1PublishingRepository } from "../../../server/publishing/repository";

const id = Astro.params.id ?? "";
const repository = new D1PublishingRepository(getBindings().DB);
const revisionCursor = parseRevisionPageCursor(Astro.url.searchParams);
const state = await loadStudioPostEditor(repository, id, revisionCursor);
if (!state) Astro.response.status = 404;
const latestRevisionHref = state ? revisionLatestHref(state.post.id) : null;
const nextRevisionHref =
  state && state.nextRevisionCursor
    ? revisionPageHref(state.post.id, state.nextRevisionCursor)
    : null;
---

{
  state ? (
    <StudioLayout
      contentKind={state.post.kind}
      title={
        state.post.title ??
        (state.post.kind === "article" ? "未命名文章" : "快速筆記")
      }
    >
      <EditorForm
        kind={state.post.kind}
        media={state.media}
        post={state.post}
        hasRevisionCursor={revisionCursor !== null}
        latestRevisionHref={latestRevisionHref}
        nextRevisionHref={nextRevisionHref}
        revisions={state.revisions}
      />
    </StudioLayout>
  ) : (
    <StudioNotFoundPage kind="post" />
  )
}
