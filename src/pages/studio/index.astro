---
import StudioIcon from "../../components/studio/StudioIcon.astro";
import StudioLayout from "../../layouts/StudioLayout.astro";
import { formatContentStatus } from "../../lib/content-status";
import { formatHongKongDate } from "../../lib/dates";
import { getBindings } from "../../server/platform/bindings";
import { D1PublishingRepository } from "../../server/publishing/repository";

const repository = new D1PublishingRepository(getBindings().DB);
const [posts, statusCounts] = await Promise.all([
  repository.listOwnerPosts(12),
  repository.countOwnerPostsByStatus(),
]);
---

<StudioLayout title="Studio 總覽">
  <div class="studio-dashboard">
    <header class="studio-dashboard__header">
      <div>
        <h1>Studio</h1>
        <p>在一個安靜、私密的地方整理與發佈內容。</p>
        <p class="en-subline" lang="en">
          Write, review, and publish from one private workspace.
        </p>
      </div>
      <div class="studio-dashboard__actions">
        <a
          class="dashboard-action dashboard-action--primary"
          href="/studio/notes/new"
          ><StudioIcon name="note" /><span
            >快速筆記<small>Quick Note</small></span
          ></a
        >
        <a class="dashboard-action" href="/studio/articles/new"
          ><StudioIcon name="article" /><span
            >新增文章<small>New Article</small></span
          ></a
        >
      </div>
    </header>

    <section class="status-ribbon" aria-label="內容狀態 Content status">
      <div>
        <strong>{statusCounts.draft}</strong><span
          >草稿 <small>Drafts</small></span
        >
      </div>
      <div>
        <strong>{statusCounts.scheduled}</strong><span
          >已排程 <small>Scheduled</small></span
        >
      </div>
      <div>
        <strong>{statusCounts.published}</strong><span
          >已發佈 <small>Published</small></span
        >
      </div>
    </section>

    <section class="recent-content" aria-labelledby="recent-heading">
      <header>
        <h2 id="recent-heading">
          最近內容 <small lang="en">Recent content</small>
        </h2>
      </header>
      {
        posts.length === 0 ? (
          <div class="recent-content__empty">
            <>
              <h3>從第一篇筆記開始。</h3>
              <p>內容會儲存在 D1，不會寫入公開 Git repository。</p>
            </>
          </div>
        ) : (
          <ul>
            {posts.map((post) => (
              <li>
                <a href={`/studio/posts/${post.id}`}>
                  <span
                    class:list={["content-kind", `content-kind--${post.kind}`]}
                  >
                    <StudioIcon
                      name={post.kind === "note" ? "note" : "article"}
                    />
                  </span>
                  <span class="content-copy">
                    <strong>
                      {post.title ??
                        post.excerpt ??
                        "未命名草稿 Untitled draft"}
                    </strong>
                    <small>
                      {post.kind === "note" ? "筆記 Note" : "文章 Article"} ·{" "}
                      {formatContentStatus(post.status)}
                      {post.hasWorkingCopy
                        ? " · 未發佈修改 Unpublished changes"
                        : ""}
                    </small>
                  </span>
                  <time datetime={post.updatedAt}>
                    {formatHongKongDate(post.updatedAt)}
                  </time>
                  <span aria-hidden="true">›</span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </section>

    <section id="media" class="privacy-note">
      <StudioIcon name="media" />
      <div>
        <h2>媒體由內容編輯器上傳 <small>Media uploads</small></h2><p>
          PNG／JPEG 會先驗證檔頭與尺寸，再存到私人 R2
          bucket；私人圖片不使用公開快取。
        </p>
      </div>
    </section>
  </div>
</StudioLayout>

<style>
  .studio-dashboard {
    width: min(100%, 74rem);
    min-height: 100svh;
    margin-inline: auto;
    padding: clamp(1.5rem, 5vw, 4rem);
  }
  .studio-dashboard__header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-6);
    padding-bottom: var(--space-7);
    border-bottom: 1px solid var(--space-border-strong);
  }
  h1 {
    margin: 0;
    font-size: var(--font-size-4);
    letter-spacing: -0.05em;
  }
  .studio-dashboard__header p {
    max-width: 38rem;
    margin: var(--space-3) 0 0;
    color: var(--space-ink-muted);
    font-size: var(--font-size-1);
  }
  .studio-dashboard__actions {
    display: flex;
    gap: var(--space-3);
  }
  .dashboard-action {
    display: flex;
    min-width: 11rem;
    min-height: 3.6rem;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--space-border-strong);
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.72);
    color: var(--space-ink);
    font-weight: 720;
    text-decoration: none;
  }
  .dashboard-action--primary {
    border-color: var(--space-primary);
    background: linear-gradient(
      135deg,
      var(--space-primary),
      var(--space-blue)
    );
    color: white;
  }
  .dashboard-action span,
  .dashboard-action small {
    display: block;
  }
  .dashboard-action small {
    color: var(--space-ink-faint);
    font-size: 0.68rem;
    font-weight: 520;
  }
  .dashboard-action--primary small {
    color: rgba(255, 255, 255, 0.76);
  }
  .status-ribbon {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: var(--space-7);
    border-block: 1px solid var(--space-border-strong);
    background: rgba(225, 244, 255, 0.56);
  }
  .status-ribbon > div {
    display: flex;
    min-height: 6rem;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    border-right: 1px solid var(--space-border);
  }
  .status-ribbon > div:last-child {
    border-right: 0;
  }
  .status-ribbon strong {
    font-size: var(--font-size-3);
    color: var(--space-primary-strong);
  }
  .status-ribbon span,
  .status-ribbon small {
    display: block;
  }
  .status-ribbon span {
    color: var(--space-ink);
    font-weight: 720;
  }
  .status-ribbon small {
    color: var(--space-ink-faint);
    font-size: 0.7rem;
    font-weight: 520;
  }
  .recent-content {
    margin-top: var(--space-7);
    border: 1px solid var(--space-border-strong);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: rgba(255, 255, 255, 0.64);
    box-shadow: var(--space-shadow-soft);
  }
  .recent-content > header {
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--space-border);
    background: linear-gradient(
      135deg,
      rgba(222, 242, 255, 0.72),
      rgba(255, 249, 220, 0.42)
    );
  }
  h2 {
    margin: 0;
    font-size: var(--font-size-1);
  }
  h2 small {
    display: inline;
    margin-left: 0.35em;
    color: var(--space-primary);
    font-size: 0.75em;
  }
  .recent-content ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .recent-content li {
    border-bottom: 1px solid var(--space-border);
  }
  .recent-content li:last-child {
    border-bottom: 0;
  }
  .recent-content a {
    display: grid;
    min-height: 5.7rem;
    grid-template-columns: 3rem minmax(0, 1fr) auto auto;
    gap: var(--space-4);
    align-items: center;
    padding: var(--space-3) var(--space-5);
    color: var(--space-ink);
    text-decoration: none;
  }
  .recent-content a:hover {
    background: var(--space-surface-hover);
  }
  .content-kind {
    display: grid;
    width: 3rem;
    height: 3rem;
    place-items: center;
    border: 1px solid var(--space-primary-soft);
    border-radius: var(--radius-md);
    background: var(--space-surface-primary);
    color: var(--space-primary);
  }
  .content-kind--article {
    border-color: var(--space-blue-soft);
    background: var(--space-surface-blue);
    color: var(--space-blue);
  }
  .content-copy,
  .content-copy strong,
  .content-copy small {
    display: block;
    min-width: 0;
  }
  .content-copy strong {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .content-copy small {
    margin-top: var(--space-1);
    color: var(--space-ink-faint);
    font-size: var(--font-size--1);
  }
  .recent-content time {
    color: var(--space-ink-faint);
    font-size: var(--font-size--1);
  }
  .recent-content__empty {
    padding: var(--space-7);
    text-align: center;
  }
  .recent-content__empty h3 {
    margin: 0;
    font-size: var(--font-size-2);
  }
  .recent-content__empty p {
    color: var(--space-ink-muted);
  }
  .privacy-note {
    display: flex;
    gap: var(--space-4);
    margin-top: var(--space-6);
    padding: var(--space-5);
    border-left: 3px solid var(--space-teal);
    background: var(--space-surface-teal);
  }
  .privacy-note > :global(.studio-icon) {
    flex: 0 0 auto;
    color: var(--space-teal-strong);
  }
  .privacy-note p {
    margin: var(--space-2) 0 0;
    color: var(--space-ink-muted);
  }

  @media (max-width: 47.99rem) {
    .studio-dashboard {
      padding: var(--space-5) var(--space-4) 7rem;
    }
    .studio-dashboard__header {
      display: block;
    }
    h1 {
      font-size: var(--font-size-3);
    }
    .studio-dashboard__header p {
      font-size: var(--font-size-0);
    }
    .studio-dashboard__actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      margin-top: var(--space-5);
    }
    .dashboard-action {
      min-width: 0;
      padding-inline: var(--space-3);
    }
    .status-ribbon {
      margin-top: var(--space-5);
    }
    .status-ribbon > div {
      display: grid;
      min-height: 5rem;
      place-content: center;
      gap: 0;
      text-align: center;
    }
    .status-ribbon strong {
      font-size: var(--font-size-2);
    }
    .recent-content {
      margin-top: var(--space-5);
    }
    .recent-content a {
      grid-template-columns: 2.75rem minmax(0, 1fr) auto;
      gap: var(--space-3);
      padding-inline: var(--space-3);
    }
    .recent-content a > span:last-child {
      display: none;
    }
    .content-kind {
      width: 2.75rem;
      height: 2.75rem;
    }
    .recent-content time {
      font-size: 0.68rem;
    }
  }
</style>
