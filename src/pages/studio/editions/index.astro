---
import StudioLayout from "../../../layouts/StudioLayout.astro";
import { formatHongKongDate } from "../../../lib/dates";
import { D1EditionRepository } from "../../../server/editions/repository";
import { getBindings } from "../../../server/platform/bindings";

const editions = await new D1EditionRepository(
  getBindings().DB,
).listOwnerEditions();
---

<StudioLayout title="Editions">
  <div class="edition-workspace">
    <header class="edition-header">
      <div>
        <p class="eyebrow">私人工作區 · Owner only</p><h1>Editions</h1><p>
          從已同步及去重的來源項目建立每日整理。
        </p>
      </div>
      <button class="button button--primary" type="button" data-generate-edition
        >建立今日草稿 <span lang="en">Generate today</span></button
      >
    </header>
    <p class="edition-status" aria-live="polite" data-edition-status></p>
    <section class="edition-list">
      <h2>草稿與已發佈內容 <small>Drafts and published</small></h2>
      {
        editions.length === 0 ? (
          <p class="edition-empty">
            暫時未有 Edition。同步來源後建立今日草稿。
          </p>
        ) : (
          <ul>
            {editions.map((edition) => (
              <li>
                <a href={`/studio/editions/${encodeURIComponent(edition.id)}`}>
                  <span>
                    <strong>{edition.title}</strong>
                    <small>
                      {edition.status} · {edition.entries.length} items
                      {edition.hasWorkingCopy ? " · 未發佈修改" : ""}
                    </small>
                  </span>
                  <time datetime={edition.updatedAt}>
                    {formatHongKongDate(edition.updatedAt)}
                  </time>
                  <b aria-hidden="true">›</b>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </section>
  </div>
</StudioLayout>

<script>
  import "../../../scripts/studio-edition";
</script>

<style>
  .edition-workspace {
    width: min(100%, 72rem);
    margin-inline: auto;
    padding: clamp(1.5rem, 5vw, 4rem);
  }
  .edition-header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-5);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--space-border-strong);
  }
  .eyebrow {
    margin: 0 0 var(--space-2);
    color: var(--space-primary-strong);
    font-size: var(--font-size--1);
    font-weight: 720;
  }
  h1 {
    margin: 0;
    font-size: var(--font-size-4);
  }
  .edition-header p:not(.eyebrow) {
    margin: var(--space-3) 0 0;
    color: var(--space-ink-muted);
  }
  .edition-status {
    min-height: 1.5rem;
    color: var(--space-teal-strong);
    font-weight: 650;
  }
  .edition-status[data-state="error"] {
    color: #a23b3b;
  }
  .edition-list {
    overflow: hidden;
    margin-top: var(--space-4);
    border: 1px solid var(--space-border-strong);
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.72);
  }
  h2 {
    margin: 0;
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--space-border);
    background: var(--space-surface-blue);
    font-size: var(--font-size-1);
  }
  h2 small {
    color: var(--space-primary);
    font-size: 0.72em;
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    border-bottom: 1px solid var(--space-border);
  }
  li:last-child {
    border: 0;
  }
  li a {
    display: grid;
    min-height: 5.5rem;
    grid-template-columns: 1fr auto auto;
    gap: var(--space-4);
    align-items: center;
    padding: var(--space-3) var(--space-5);
    color: var(--space-ink);
    text-decoration: none;
  }
  li a:hover {
    background: var(--space-surface-hover);
  }
  li span,
  li strong,
  li small {
    display: block;
  }
  li small,
  li time {
    margin-top: var(--space-1);
    color: var(--space-ink-faint);
    font-size: var(--font-size--1);
  }
  .edition-empty {
    padding: var(--space-7);
    color: var(--space-ink-muted);
    text-align: center;
  }
  @media (max-width: 47.99rem) {
    .edition-workspace {
      padding: var(--space-5) var(--space-4) 7rem;
    }
    .edition-header {
      display: block;
    }
    .edition-header .button {
      margin-top: var(--space-4);
    }
    h1 {
      font-size: var(--font-size-3);
    }
    li a {
      grid-template-columns: 1fr auto;
    }
    li time {
      display: none;
    }
  }
</style>
