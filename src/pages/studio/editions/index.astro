---
import StudioLayout from "../../../layouts/StudioLayout.astro";
import {
  formatContentStatus,
  formatEditionItemCount,
} from "../../../lib/content-status";
import { formatHongKongDate } from "../../../lib/dates";
import {
  editionPageHref,
  parseEditionPageCursor,
} from "../../../server/editions/pagination";
import { D1EditionRepository } from "../../../server/editions/repository";
import { getBindings } from "../../../server/platform/bindings";

const cursor = parseEditionPageCursor(Astro.url.searchParams);
const page = await new D1EditionRepository(
  getBindings().DB,
).listOwnerEditionPage(cursor);
const nextHref = page.nextCursor ? editionPageHref(page.nextCursor) : null;
---

<StudioLayout title="Editions">
  <div class="edition-workspace">
    <header class="edition-header">
      <div>
        <p class="eyebrow">私人工作區 · Owner only</p><h1>Editions</h1><p>
          從已同步及去重的來源項目建立每日整理。
        </p>
      </div>
      <button class="button button--primary" type="button" data-generate-edition
        >建立今日草稿 <span lang="en">Generate today</span></button
      >
    </header>
    <p class="edition-status" aria-live="polite" data-edition-status></p>
    <section id="edition-list" class="edition-list">
      <h2>草稿與已發佈內容 <small>Drafts and published</small></h2>
      {
        page.editions.length === 0 ? (
          <div class="edition-empty">
            <p>
              {cursor
                ? "這個分頁已沒有 Edition。 This page no longer has Editions."
                : "暫時未有 Edition。同步來源後建立今日草稿。 No Editions yet. Sync sources, then generate today's draft."}
            </p>
            {cursor && (
              <a class="button" href="/studio/editions#edition-list">
                返回最新 Editions <span lang="en">Return to latest</span>
              </a>
            )}
          </div>
        ) : (
          <>
            <ul>
              {page.editions.map((edition) => (
                <li>
                  <a
                    href={`/studio/editions/${encodeURIComponent(edition.id)}`}
                  >
                    <span>
                      <strong>{edition.title}</strong>
                      <small>
                        {formatContentStatus(edition.status)} ·{" "}
                        {formatEditionItemCount(edition.entries.length)}
                        {edition.hasWorkingCopy
                          ? " · 未發佈修改 Unpublished changes"
                          : ""}
                      </small>
                    </span>
                    <time datetime={edition.updatedAt}>
                      {formatHongKongDate(edition.updatedAt)}
                    </time>
                    <b aria-hidden="true">›</b>
                  </a>
                </li>
              ))}
            </ul>
            {nextHref && (
              <div class="edition-more">
                <a class="button" href={nextHref}>
                  載入較早 Editions <span lang="en">Load older</span>
                </a>
              </div>
            )}
          </>
        )
      }
    </section>
  </div>
</StudioLayout>

<script>
  import "../../../scripts/studio-edition";
</script>

<style>
  .edition-workspace {
    width: min(100%, 72rem);
    margin-inline: auto;
    padding: clamp(1.5rem, 5vw, 4rem);
  }
  .edition-header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-5);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--space-border-strong);
  }
  .eyebrow {
    margin: 0 0 var(--space-2);
    color: var(--space-primary-strong);
    font-size: var(--font-size--1);
    font-weight: 720;
  }
  h1 {
    margin: 0;
    font-size: var(--font-size-4);
  }
  .edition-header p:not(.eyebrow) {
    margin: var(--space-3) 0 0;
    color: var(--space-ink-muted);
  }
  .edition-status {
    min-height: 1.5rem;
    color: var(--space-teal-strong);
    font-weight: 650;
  }
  .edition-status[data-state="error"] {
    color: #a23b3b;
  }
  .edition-list {
    overflow: hidden;
    margin-top: var(--space-4);
    border: 1px solid var(--space-border-strong);
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.72);
  }
  h2 {
    margin: 0;
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--space-border);
    background: var(--space-surface-blue);
    font-size: var(--font-size-1);
  }
  h2 small {
    color: var(--space-primary);
    font-size: 0.72em;
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    border-bottom: 1px solid var(--space-border);
  }
  li:last-child {
    border: 0;
  }
  li a {
    display: grid;
    min-height: 5.5rem;
    grid-template-columns: 1fr auto auto;
    gap: var(--space-4);
    align-items: center;
    padding: var(--space-3) var(--space-5);
    color: var(--space-ink);
    text-decoration: none;
  }
  li a:hover {
    background: var(--space-surface-hover);
  }
  li span,
  li strong,
  li small {
    display: block;
  }
  li small,
  li time {
    margin-top: var(--space-1);
    color: var(--space-ink-faint);
    font-size: var(--font-size--1);
  }
  .edition-empty {
    display: grid;
    justify-items: center;
    gap: var(--space-4);
    padding: var(--space-7);
    color: var(--space-ink-muted);
    text-align: center;
  }
  .edition-empty p {
    margin: 0;
  }
  .edition-more {
    display: flex;
    justify-content: center;
    padding: var(--space-4);
    border-top: 1px solid var(--space-border);
  }
  @media (max-width: 47.99rem) {
    .edition-workspace {
      padding: var(--space-5) var(--space-4) 7rem;
    }
    .edition-header {
      display: block;
    }
    .edition-header .button {
      margin-top: var(--space-4);
    }
    h1 {
      font-size: var(--font-size-3);
    }
    li a {
      grid-template-columns: 1fr auto;
    }
    li time {
      display: none;
    }
  }
</style>
