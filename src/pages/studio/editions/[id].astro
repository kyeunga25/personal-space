---
import { EDITION_INPUT_LIMITS } from "../../../config/editions";
import StudioLayout from "../../../layouts/StudioLayout.astro";
import { formatContentStatus } from "../../../lib/content-status";
import { formatHongKongDate } from "../../../lib/dates";
import { formatEditionItemPosition } from "../../../scripts/edition-item-order";
import { getEditorCharacterCount } from "../../../scripts/editor-input";
import { createExcerpt } from "../../../server/content/markdown";
import { D1EditionRepository } from "../../../server/editions/repository";
import { getBindings } from "../../../server/platform/bindings";

const id = Astro.params.id ?? "";
const edition = await new D1EditionRepository(
  getBindings().DB,
).findOwnerEdition(id);
if (!edition) {
  Astro.response.status = 404;
}
const titleCount = getEditorCharacterCount(
  edition?.title ?? "",
  EDITION_INPUT_LIMITS.title,
);
const introCount = getEditorCharacterCount(
  edition?.introMd ?? "",
  EDITION_INPUT_LIMITS.introMd,
);
---

<StudioLayout title={edition?.title ?? "找不到 Edition"}>
  <div class="edition-editor">
    {
      edition ? (
        <form
          method="post"
          action={`/api/studio/editions/${encodeURIComponent(edition.id)}`}
          data-edition-form
          data-edition-id={edition.id}
        >
          <header>
            <>
              <div>
                <>
                  <p class="eyebrow">
                    {edition.date} · {formatContentStatus(edition.status)}
                    {edition.hasWorkingCopy
                      ? " · 未發佈修改 Unpublished changes"
                      : ""}
                  </p>
                  <h1>
                    編輯 Edition <small>Edit edition</small>
                  </h1>
                </>
              </div>
              <a class="button" href="/studio/editions">
                返回列表 Back
              </a>
            </>
          </header>
          <p class="editor-status" aria-live="polite" data-edition-status />
          {edition.hasWorkingCopy && (
            <p class="working-copy-notice">
              這是只限 Studio 的工作副本；公開 Edition 仍維持上一個已發佈版本。
              <span lang="en">
                This working copy is visible only in Studio; the public Edition
                still uses the previous published version.
              </span>
            </p>
          )}
          <section class="editor-fields">
            <label>
              標題{" "}
              <>
                <small>Title</small>
                <input
                  name="title"
                  maxlength={EDITION_INPUT_LIMITS.title}
                  aria-describedby="edition-title-count"
                  value={edition.title}
                  required
                />
                <small
                  id="edition-title-count"
                  class="edition-character-count"
                  data-edition-character-count
                  data-field-name="title"
                  data-limit={EDITION_INPUT_LIMITS.title}
                  data-state={titleCount.state}
                  aria-live="polite"
                  aria-atomic="true"
                >
                  {titleCount.label}
                </small>
              </>
            </label>
            <label>
              引言{" "}
              <>
                <small>Introduction · Markdown</small>
                <textarea
                  name="introMd"
                  rows="6"
                  maxlength={EDITION_INPUT_LIMITS.introMd}
                  aria-describedby="edition-intro-count"
                >
                  {edition.introMd}
                </textarea>
                <small
                  id="edition-intro-count"
                  class="edition-character-count"
                  data-edition-character-count
                  data-field-name="introMd"
                  data-limit={EDITION_INPUT_LIMITS.introMd}
                  data-state={introCount.state}
                  aria-live="polite"
                  aria-atomic="true"
                >
                  {introCount.label}
                </small>
              </>
            </label>
          </section>
          <section class="edition-items">
            <h2>
              內容項目 <small>Edition items</small>
            </h2>
            {edition.entries.length === 0 ? (
              <p class="empty">
                最近 36 小時未有新的來源項目；先到來源頁同步 feeds。
                <span lang="en">
                  No new source items were found in the last 36 hours. Sync
                  feeds on the Sources page first.
                </span>
              </p>
            ) : (
              <ol data-edition-item-list>
                {edition.entries.map((entry, entryIndex) => (
                  <li data-edition-item>
                    <div class="item-controls">
                      <span class="item-position" data-edition-item-position>
                        {formatEditionItemPosition(
                          entryIndex,
                          edition.entries.length,
                        )}
                      </span>
                      <label class="item-toggle">
                        <input
                          type="checkbox"
                          name="includedItemIds"
                          value={entry.itemId}
                          checked
                        />
                        <span>保留 Include</span>
                      </label>
                      <div
                        class="item-order-controls"
                        role="group"
                        aria-label={`調整「${entry.title}」次序 Reorder: ${entry.title}`}
                      >
                        <button
                          class="item-order-button"
                          type="button"
                          data-edition-item-move="up"
                          aria-label={`向上移動：${entry.title} Move up: ${entry.title}`}
                          disabled={entryIndex === 0}
                        >
                          ↑ 上移 <span lang="en">Up</span>
                        </button>
                        <button
                          class="item-order-button"
                          type="button"
                          data-edition-item-move="down"
                          aria-label={`向下移動：${entry.title} Move down: ${entry.title}`}
                          disabled={entryIndex === edition.entries.length - 1}
                        >
                          ↓ 下移 <span lang="en">Down</span>
                        </button>
                      </div>
                    </div>
                    <div>
                      <strong>{entry.title}</strong>
                      {entry.summary && (
                        <p>{createExcerpt(entry.summary, 480)}</p>
                      )}
                      <small>
                        {entry.sourceName} ·{" "}
                        {formatHongKongDate(entry.publishedAt)}
                      </small>
                      <a
                        href={entry.url}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        檢視原文 Source
                      </a>
                      <label class="annotation">
                        編輯註解 <small>Annotation</small>
                        <textarea
                          name={`annotation:${entry.itemId}`}
                          rows="3"
                          maxlength={EDITION_INPUT_LIMITS.annotation}
                          aria-describedby={`edition-annotation-count-${entryIndex}`}
                        >
                          {entry.annotation}
                        </textarea>
                        <small
                          id={`edition-annotation-count-${entryIndex}`}
                          class="edition-character-count"
                          data-edition-character-count
                          data-field-name={`annotation:${entry.itemId}`}
                          data-limit={EDITION_INPUT_LIMITS.annotation}
                          data-state={
                            getEditorCharacterCount(
                              entry.annotation,
                              EDITION_INPUT_LIMITS.annotation,
                            ).state
                          }
                          aria-live="polite"
                          aria-atomic="true"
                        >
                          {
                            getEditorCharacterCount(
                              entry.annotation,
                              EDITION_INPUT_LIMITS.annotation,
                            ).label
                          }
                        </small>
                      </label>
                    </div>
                  </li>
                ))}
              </ol>
            )}
          </section>
          <footer class="editor-actions">
            <>
              <button class="button" type="submit" name="action" value="save">
                {edition.status === "published"
                  ? "儲存工作副本 Save working copy"
                  : "儲存草稿 Save"}
              </button>
              <button
                class="button button--primary"
                type="submit"
                name="action"
                value="publish"
              >
                發佈 Publish
              </button>
              <button
                class="button button--danger"
                type="submit"
                name="action"
                value="archive"
              >
                封存 Archive
              </button>
            </>
          </footer>
        </form>
      ) : (
        <section class="not-found">
          <>
            <h1>找不到 Edition</h1>
            <a class="button" href="/studio/editions">
              返回列表 Back
            </a>
          </>
        </section>
      )
    }
  </div>
</StudioLayout>

<script>
  import "../../../scripts/studio-edition";
</script>

<style>
  .edition-editor {
    width: min(100%, 72rem);
    margin-inline: auto;
    padding: clamp(1.5rem, 5vw, 4rem);
  }
  header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-4);
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--space-border-strong);
  }
  .eyebrow {
    margin: 0 0 var(--space-2);
    color: var(--space-primary-strong);
    font-weight: 720;
  }
  h1 {
    margin: 0;
    font-size: var(--font-size-3);
  }
  h1 small,
  h2 small {
    color: var(--space-primary);
    font-size: 0.5em;
  }
  .editor-status {
    min-height: 1.5rem;
    color: var(--space-teal-strong);
    font-weight: 650;
  }
  .editor-status[data-state="error"] {
    color: #a23b3b;
  }
  .working-copy-notice {
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--space-border-strong);
    border-radius: var(--radius-sm);
    background: var(--space-surface-blue);
    color: var(--space-primary-strong);
    font-weight: 650;
  }
  .working-copy-notice span,
  .empty span {
    display: block;
    margin-top: var(--space-1);
    color: var(--space-ink-faint);
    font-weight: 520;
  }
  .editor-fields {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-5);
    border: 1px solid var(--space-border-strong);
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.72);
  }
  label {
    display: grid;
    gap: var(--space-2);
    color: var(--space-ink-muted);
    font-weight: 680;
  }
  label small {
    color: var(--space-ink-faint);
  }
  .edition-character-count {
    display: block;
    color: var(--space-ink-faint);
    font-size: var(--font-size--1);
    font-weight: 540;
  }
  .edition-character-count[data-state="near"] {
    color: var(--space-primary-strong);
    font-weight: 700;
  }
  .edition-character-count[data-state="limit"] {
    color: #9a3030;
    font-weight: 750;
  }
  input[type="text"],
  input:not([type]),
  textarea {
    width: 100%;
    padding: 0.75rem;
    border: 1px solid var(--space-border-strong);
    border-radius: var(--radius-sm);
    background: white;
    color: var(--space-ink);
    font: inherit;
  }
  .edition-items {
    overflow: hidden;
    margin-top: var(--space-5);
    border: 1px solid var(--space-border-strong);
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.72);
  }
  h2 {
    margin: 0;
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--space-border);
    background: var(--space-surface-blue);
  }
  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-4);
    padding: var(--space-5);
    border-bottom: 1px solid var(--space-border);
  }
  li:last-child {
    border: 0;
  }
  .item-toggle {
    align-content: start;
  }
  .item-controls {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    min-width: 8.5rem;
  }
  .item-position {
    color: var(--space-ink-faint);
    font-size: var(--font-size--1);
    font-weight: 650;
  }
  .item-order-controls {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .item-order-button {
    min-height: 2.5rem;
    padding: 0.5rem 0.65rem;
    border: 1px solid var(--space-border-strong);
    border-radius: var(--radius-sm);
    background: white;
    color: var(--space-primary-strong);
    font: inherit;
    font-size: var(--font-size--1);
    font-weight: 700;
    cursor: pointer;
  }
  .item-order-button:disabled {
    color: var(--space-ink-faint);
    cursor: not-allowed;
    opacity: 0.55;
  }
  .item-order-button span {
    display: block;
    font-size: 0.82em;
  }
  li strong {
    font-size: var(--font-size-1);
  }
  li p {
    max-width: 50rem;
    color: var(--space-ink-muted);
  }
  li > div > small {
    color: var(--space-ink-faint);
  }
  li a {
    display: inline-block;
    margin-left: var(--space-3);
    color: var(--space-primary-strong);
  }
  .annotation {
    margin-top: var(--space-4);
  }
  .empty,
  .not-found {
    padding: var(--space-7);
    text-align: center;
    color: var(--space-ink-muted);
  }
  .editor-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }
  .button--danger {
    margin-left: auto;
    border-color: rgba(162, 59, 59, 0.38);
    color: #8b3030;
  }
  @media (max-width: 47.99rem) {
    .edition-editor {
      padding: var(--space-5) var(--space-4) 7rem;
    }
    header {
      display: block;
    }
    header .button {
      margin-top: var(--space-3);
    }
    li {
      grid-template-columns: 1fr;
    }
    .button--danger {
      margin-left: 0;
    }
  }
</style>
