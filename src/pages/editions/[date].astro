---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatHongKongDate } from "../../lib/dates";
import { editionSourceLinkLabel } from "../../lib/edition-source-link";
import { publicNotFoundCopy } from "../../lib/not-found";
import { createExcerpt, renderMarkdown } from "../../server/content/markdown";
import { normalizeEditionDate } from "../../server/editions/pagination";
import { D1EditionRepository } from "../../server/editions/repository";
import { getBindings } from "../../server/platform/bindings";

const date = normalizeEditionDate(Astro.params.date ?? "");
const edition = date
  ? await new D1EditionRepository(getBindings().DB).findPublicEditionByDate(
      date,
    )
  : null;
if (!edition) Astro.response.status = 404;
const introHtml = edition ? renderMarkdown(edition.introMd) : "";
const missingCopy = publicNotFoundCopy("edition");
---

<BaseLayout
  title={edition?.title ?? missingCopy.title}
  titleEn={edition ? "Edition" : missingCopy.titleEn}
  description={edition?.introMd
    ? createExcerpt(edition.introMd, 155)
    : edition
      ? "公開來源整理。"
      : missingCopy.description}
  descriptionEn={edition
    ? "A reviewed edition with links to original public sources."
    : missingCopy.descriptionEn}
  noIndex={!edition}
>
  <div class="page-stack">
    {
      edition ? (
        <article class="edition-detail">
          <>
            <header>
              <h1>{edition.title}</h1>
              {introHtml && (
                <div class="edition-intro prose" set:html={introHtml} />
              )}
            </header>
            <ol>
              {edition.entries.map((entry) => (
                <li>
                  <article>
                    <div class="entry-meta">
                      <span>{entry.sourceName}</span>
                      <time datetime={entry.publishedAt ?? undefined}>
                        {formatHongKongDate(entry.publishedAt)}
                      </time>
                    </div>
                    <h2>{entry.title}</h2>
                    {entry.summary && (
                      <p>{createExcerpt(entry.summary, 280)}</p>
                    )}
                    {entry.annotation && (
                      <blockquote>{entry.annotation}</blockquote>
                    )}
                    <a
                      class="source-link"
                      href={entry.url}
                      target="_blank"
                      rel="noopener noreferrer nofollow"
                      aria-label={editionSourceLinkLabel(entry.title)}
                    >
                      閱讀原文 <span lang="en">Read source ↗</span>
                    </a>
                  </article>
                </li>
              ))}
            </ol>
            <footer class="source-notice">
              <p>
                摘錄及標題的版權屬原發布者；內容可能更新，請以連結原文為準。
              </p>
              <p lang="en">
                Titles and excerpts remain the property of their publishers;
                follow each source for the current version.
              </p>
            </footer>
          </>
        </article>
      ) : (
        <section class="edition-missing">
          <p class="page-kicker">404</p>
          <h1>
            {missingCopy.heading}
            <small lang="en">{missingCopy.headingEn}</small>
          </h1>
          <p>{missingCopy.description}</p>
          <p class="en-subline" lang="en">
            {missingCopy.descriptionEn}
          </p>
          <div class="button-row">
            <a class="button button--primary" href={missingCopy.backHref}>
              {missingCopy.backLabel}
              <span lang="en">{missingCopy.backLabelEn}</span>
            </a>
            <a class="button" href="/search">
              搜尋空間 <span lang="en">Search</span>
            </a>
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  .edition-detail > header {
    padding: clamp(1.75rem, 5vw, 3.5rem) var(--page-gutter);
    border-bottom: 1px solid var(--space-border-strong);
    background: linear-gradient(
      135deg,
      rgba(222, 242, 255, 0.7),
      rgba(255, 249, 220, 0.5)
    );
  }
  .edition-date {
    margin: 0;
    color: var(--space-teal-strong);
    font-weight: 720;
  }
  h1 {
    max-width: 18ch;
    margin: var(--space-3) 0 0;
    font-size: var(--font-size-4);
    letter-spacing: -0.045em;
  }
  .edition-intro {
    max-width: 44rem;
    margin-top: var(--space-5);
    color: var(--space-ink-muted);
  }
  ol {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: edition;
  }
  li {
    counter-increment: edition;
    border-bottom: 1px solid var(--space-border);
  }
  li > article {
    position: relative;
    padding: clamp(1.5rem, 4vw, 2.5rem) var(--page-gutter);
  }
  li > article::before {
    position: absolute;
    top: 1.6rem;
    right: var(--page-gutter);
    color: var(--space-border-strong);
    font-size: var(--font-size-4);
    font-weight: 780;
    content: counter(edition, decimal-leading-zero);
  }
  .entry-meta {
    display: flex;
    gap: var(--space-4);
    color: var(--space-ink-faint);
    font-size: var(--font-size--1);
  }
  .entry-meta span {
    color: var(--space-teal-strong);
    font-weight: 720;
  }
  h2 {
    max-width: 38rem;
    margin: var(--space-3) 0 0;
    font-size: var(--font-size-2);
  }
  li p,
  blockquote {
    max-width: 42rem;
    color: var(--space-ink-muted);
  }
  blockquote {
    margin: var(--space-4) 0 0;
    padding: var(--space-3) var(--space-4);
    border-left: 3px solid var(--space-yellow);
    background: var(--space-surface-yellow);
  }
  .source-link {
    display: inline-block;
    margin-top: var(--space-4);
    color: var(--space-primary-strong);
    font-weight: 700;
  }
  .source-notice {
    padding: var(--space-5) var(--page-gutter);
    color: var(--space-ink-faint);
    font-size: var(--font-size--1);
  }
  .source-notice p {
    margin: 0;
  }
  .source-notice p + p {
    margin-top: var(--space-1);
  }
  .edition-missing {
    padding: var(--space-8) var(--page-gutter);
    text-align: center;
  }
  .edition-missing h1 {
    max-width: none;
  }
  .edition-missing h1 small {
    display: block;
    margin-top: var(--space-2);
    color: var(--space-primary);
    font-size: 0.5em;
  }
  .edition-missing > p:not(.page-kicker) {
    max-width: 46rem;
    margin-inline: auto;
    color: var(--space-ink-muted);
  }
  .edition-missing .button-row {
    justify-content: center;
  }
  @media (max-width: 47.99rem) {
    h1 {
      font-size: var(--font-size-3);
    }
    li > article::before {
      font-size: var(--font-size-2);
    }
  }
</style>
