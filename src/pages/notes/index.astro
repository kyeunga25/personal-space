---
import PostListPage from "../../components/PostListPage.astro";
import {
  parseKindDiscoveryFilters,
  withCursor,
} from "../../server/discovery/filters";
import { getBindings } from "../../server/platform/bindings";
import { D1PublishingRepository } from "../../server/publishing/repository";

const filters = parseKindDiscoveryFilters(Astro.url.searchParams, "note", 20);
const result = await new D1PublishingRepository(
  getBindings().DB,
).listPublicDiscovery(filters, new Date().toISOString());
const nextHref = result.nextCursor
  ? withCursor(filters, result.nextCursor)
  : null;
---

<PostListPage
  title="筆記"
  titleEn="Notes"
  description="短小、即時，保存值得留下來的片刻。"
  descriptionEn="Short, immediate notes for moments worth keeping."
  kind="note"
  posts={result.posts}
  {nextHref}
/>
