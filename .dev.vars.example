# Local Studio only. Copy to .dev.vars for local testing.
# The bypass also requires a loopback request URL such as http://localhost.
APP_ENV=development
LOCAL_STUDIO_BYPASS=true
LOCAL_OWNER_EMAIL=owner@local.invalid
INGEST_CRON="0 0 * * *"
EDITION_CRON="0 1 * * *"

# Production uses Cloudflare secrets instead. Never commit real values.
# ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
# ACCESS_AUD=your-access-application-audience
# OWNER_EMAIL=owner@example.invalid
